<turbo-frame id="session-composer-overlay">
    <section class="session-composer-overlay" role="dialog" aria-modal="true" aria-labelledby="session-media-create-title">
        <div class="session-composer-overlay__panel session-composer-overlay__panel--activity">
            <div class="internal-page-heading">
                <div>
                    <p class="internal-eyebrow">{{ 'sessions.media.new.eyebrow'|trans({}, 'sessions') }}</p>
                    <h2 id="session-media-create-title">{{ 'sessions.sequence.composer.create_catalog_media'|trans({}, 'sessions') }}</h2>
                </div>
                <a class="session-composer-overlay__close" href="{{ path('session_sequence_edit', { uuid: session.uuid, sequenceUuid: sequence.uuid, composer: 1 }) }}" aria-label="{{ 'sessions.sequence.composer.close'|trans({}, 'sessions') }}">×</a>
            </div>
            {% if hasErrors %}<div class="internal-alert internal-alert--error">{{ 'sessions.media.form.error_notice'|trans({}, 'sessions') }}</div>{% endif %}
            {{ form_start(form, { attr: { class: 'internal-form internal-form--wide session-media-create-form' } }) }}
                <div class="internal-form__grid">
                    {{ form_row(form.type) }}
                    {{ form_row(form.title) }}
                </div>
                <div class="internal-form__grid">
                    {{ form_row(form.primaryUrl) }}
                    {{ form_row(form.primaryFile) }}
                </div>
                {{ form_row(form.source) }}
                {{ form_row(form.description) }}
                {{ form_row(form.secondaryUrl) }}
                <div class="internal-form__grid">
                    {{ form_row(form.imageUrl) }}
                    {{ form_row(form.imageFile) }}
                </div>
                {{ form_row(form.themeUuids) }}
                {{ form_row(form.active) }}
                <div class="internal-form__actions">{{ form_widget(form.submit) }}</div>
            {{ form_end(form) }}
        </div>
    </section>
</turbo-frame>
