{% set isNewActivity = sequence is null %}
<turbo-frame id="session-composer-overlay">
    <section class="session-composer-overlay" role="dialog" aria-modal="true" aria-labelledby="session-activity-title" data-controller="media-create-dialog">
        <div class="session-composer-overlay__panel session-composer-overlay__panel--activity">
            <div class="internal-page-heading">
                <div>
                    <p class="internal-eyebrow">{{ 'sessions.sequence.composer.activity_eyebrow'|trans({}, 'sessions') }}</p>
                    <h2 id="session-activity-title">{{ sequence and sequence.title ? 'sessions.sequence.edit.title'|trans({ title: sequence.title }, 'sessions') : 'sessions.sequence.composer.activity_heading'|trans({}, 'sessions') }}</h2>
                    <p>{{ 'sessions.sequence.composer.activity_description'|trans({}, 'sessions') }}</p>
                </div>
                <a class="session-composer-overlay__close" href="{{ path('session_edit', { uuid: session.uuid }) }}" data-turbo-frame="_top" aria-label="{{ 'sessions.sequence.composer.close'|trans({}, 'sessions') }}">×</a>
            </div>

            {{ form_start(form, {
                action: isNewActivity
                    ? path('session_sequence_new', { uuid: session.uuid, composer: 1 })
                    : path('session_sequence_edit', { uuid: session.uuid, sequenceUuid: sequence.uuid, composer: 1 }),
                attr: { class: 'internal-form internal-form--wide session-activity-form', 'data-turbo-frame': 'session-composer-overlay' }
            }) }}
                {{ form_row(form.title) }}
                {{ form_row(form.instrumentUuids) }}
                <div class="internal-form__grid">
                    {{ form_row(form.role) }}
                </div>
                {% include 'session/_role_suggestions.html.twig' with { id: 'session-sequence-role-suggestions' } only %}
                {{ form_row(form.body) }}
                {% include 'media_resource/_association_picker.html.twig' with { field: form.catalogMediaUuids } only %}
                <details class="internal-disclosure">
                    <summary>{{ 'sessions.sequence.form.lyrics_and_gestures'|trans({}, 'sessions') }}</summary>
                    {{ form_row(form.lyrics) }}
                    {{ form_row(form.gestures) }}
                </details>
                {{ form_row(form.subtitle) }}
                {{ form_row(form.showLyricsByDefault) }}
                {{ form_widget(form.sourceUuid) }}
                {{ form_widget(form.sourceTitle) }}
                <div class="internal-form__actions">
                    <a class="internal-button internal-button--secondary internal-form__back-action" href="{{ path('session_edit', { uuid: session.uuid }) }}" data-turbo-frame="_top">{{ 'sessions.sequence.form.back'|trans({}, 'sessions') }}</a>
                    {{ form_widget(form.submit, { label: 'sessions.sequence.form.submit'|trans({}, 'sessions') }) }}
                </div>
            {{ form_end(form) }}
            <dialog class="internal-form-dialog media-create-dialog" data-media-create-dialog-target="dialog" data-action="click->media-create-dialog#closeOnBackdrop"><div class="internal-form-dialog__panel">
                <button type="button" class="internal-icon-button" data-action="media-create-dialog#close" aria-label="{{ 'sessions.sequence.composer.close'|trans({}, 'sessions') }}">×</button>
                <turbo-frame id="media-resource-create"></turbo-frame>
            </div></dialog>
        </div>
    </section>
</turbo-frame>
