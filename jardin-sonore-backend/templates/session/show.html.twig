{% extends 'internal/base.html.twig' %}

{% set title = session.title %}

{% block head %}<meta name="turbo-cache-control" content="no-cache">{% endblock %}

{% block internal_body %}
    <section class="internal-page-heading print:hidden">
        <div>
            <p class="internal-eyebrow">{{ 'sessions.preview.eyebrow'|trans({}, 'sessions') }}</p>
            <h1>{{ session.title }}</h1>
            <p>{{ 'sessions.preview.description'|trans({}, 'sessions') }}</p>
        </div>
        <div class="internal-heading-actions">
            <a class="internal-button internal-button--secondary" href="{{ path('session_edit', { uuid: session.uuid }) }}">{{ 'sessions.preview.edit'|trans({}, 'sessions') }}</a>
            {% if documentAvailable %}
                <a class="internal-button" href="{{ path('session_document_download', { uuid: session.uuid }) }}">{{ 'sessions.summary.document.download'|trans({}, 'sessions') }}</a>
            {% else %}
                <span class="internal-badge internal-badge--{{ session.documentStatus.value == 'ready' ? 'success' : session.documentStatus.value == 'failed' ? 'danger' : 'warning' }}">{{ ('sessions.summary.document.' ~ session.documentStatus.value)|trans({}, 'sessions') }}</span>
            {% endif %}
        </div>
    </section>

    <article class="session-document">
        <section class="session-document__hero">
            <div class="session-document__accent"></div>
            <h1>{{ session.title }}</h1>
            {% if session.theme %}<p>{{ session.theme }}</p>{% endif %}
        </section>

        {% if session.instrumentNames is not empty %}
            <section class="session-document__materials">
                <p class="internal-eyebrow">Instruments utilisés</p>
                <p>{{ session.instrumentNames|join(' · ') }}</p>
            </section>
        {% endif %}

        {% if session.materialSummary %}
            <section class="session-document__materials">
                <p class="internal-eyebrow">{{ 'sessions.preview.material_summary'|trans({}, 'sessions') }}</p>
                <p>{{ session.materialSummary|nl2br }}</p>
            </section>
        {% endif %}

        <section class="session-document__sequences">
            {% for sequence in session.sequences %}
                <article class="session-document__sequence session-document__sequence--{{ sequence.type.value }}">
                    <div class="session-document__number">{{ loop.index }}</div>
                    <div class="session-document__sequence-content">
                    <p class="session-document__badge">{{ sequence.type.translationKey()|trans({}, 'sessions') }}</p>
                    {% if sequence.role %}<p class="internal-eyebrow">{{ sequence.role }}</p>{% endif %}
                    <h2>{{ sequence.title }}{% if sequence.subtitle %}<span>— {{ sequence.subtitle }}</span>{% endif %}</h2>
                    {% if sequence.subtitle %}
                        {# subtitle is visually included in the title, as in the validated layout #}
                    {% endif %}

                    {% if sequence.body and sequence.body != sequence.lyrics %}
                        <div style="margin-top: .75rem;">{{ sequence.body|nl2br }}</div>
                    {% endif %}

                    {% if sequence.generalInstructions %}
                        <div style="margin-top: .75rem;">{{ sequence.generalInstructions|nl2br }}</div>
                    {% endif %}

                    {% if sequence.contentBlocks is not empty %}
                        <details style="margin-top: .75rem;" {% if sequence.showLyricsByDefault %}open{% endif %}>
                            <summary>{{ 'sessions.preview.lyrics'|trans({}, 'sessions') }}</summary>
                            <div class="session-document__lyrics session-document__lyrics-panel">
                                {% for contentBlock in sequence.contentBlocks %}
                                    {% if contentBlock.kind.value == 'line' %}
                                        <div class="session-document__lyric-pair">
                                            <p class="session-document__lyric-line">{{ contentBlock.text }}</p>
                                            {% if contentBlock.gesture %}<p class="session-document__gesture">{{ contentBlock.gesture }}</p>{% endif %}
                                        </div>
                                    {% elseif contentBlock.kind.value == 'section' %}
                                        <p class="session-document__lyrics-section">{{ contentBlock.text }}</p>
                                    {% else %}
                                        <div class="session-document__lyrics-break"></div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </details>
                    {% elseif sequence.lyrics %}
                        <details style="margin-top: .75rem;" {% if sequence.showLyricsByDefault %}open{% endif %}>
                            <summary>{{ 'sessions.preview.lyrics'|trans({}, 'sessions') }}</summary>
                            <div class="session-document__lyrics session-document__lyrics-panel">
                                <div class="session-document__lyric-pair">
                                    {% if sequence.lyrics %}<p class="session-document__lyric-line">{{ sequence.lyrics|nl2br }}</p>{% endif %}
                                    {% if sequence.gestures %}<p class="session-document__gesture">{{ sequence.gestures|nl2br }}</p>{% endif %}
                                </div>
                            </div>
                        </details>
                    {% endif %}

                    {% set documentMedia = sequence.documentMedia is empty ? sequence.media : sequence.documentMedia %}
                    {% if documentMedia is not empty %}
                        <div class="session-document__media">
                            {% for media in documentMedia %}
                                {% if media.displayedOnSession %}
                                    {% set youtubeVideoId = media.featured
                                        ? media.url|replace({
                                            'https://www.youtube.com/watch?v=': '',
                                            'https://youtu.be/': '',
                                            'https://www.youtube.com/embed/': ''
                                        })|split('&')|first
                                        : null %}
                                    <div class="session-document__media-item">
                                        {% if youtubeVideoId matches '/^[A-Za-z0-9_-]{11}$/' %}
                                            <iframe class="session-document__youtube" src="https://www.youtube-nocookie.com/embed/{{ youtubeVideoId }}" title="{{ media.label }}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                                        {% else %}
                                            <a href="{{ media.url }}" target="_blank" rel="noopener noreferrer">{{ media.label }}</a>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                    </div>
                </article>
            {% endfor %}
        </section>

        {% if session.recommendations is not empty or session.furtherExploration %}
            <section class="session-document__further-exploration">
                <h2>Pour aller plus loin dans la séance</h2>
                {% if session.furtherExploration %}<p>{{ session.furtherExploration|nl2br }}</p>{% endif %}
                {% if session.recommendations is not empty %}
                    <ul>{% for recommendation in session.recommendations %}<li><strong>{{ recommendation.title }}</strong><br>{{ recommendation.text|nl2br }}{% if recommendation.primaryUrl %}<br><a href="{{ recommendation.primaryUrl }}" target="_blank" rel="noopener noreferrer">Lien</a>{% endif %}</li>{% endfor %}</ul>
                {% endif %}
            </section>
        {% endif %}
    </article>
{% endblock %}
