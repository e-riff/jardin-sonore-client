<section
    id="session-composer"
    class="internal-card session-composer"
    data-controller="session-sequence-sorter"
    data-session-sequence-sorter-url-value="{{ path('session_sequence_reorder', { uuid: session.uuid }) }}"
    data-session-sequence-sorter-csrf-token-value="{{ csrf_token('session_sequence_reorder_' ~ session.uuid) }}"
    data-session-sequence-sorter-error-message-value="{{ 'sessions.sequence.composer.reorder_error'|trans({}, 'sessions') }}"
>
    <div class="internal-page-heading">
        <div>
            <p class="internal-eyebrow">{{ 'sessions.sequence.index.eyebrow'|trans({}, 'sessions') }}</p>
            <h2>{{ 'sessions.sequence.composer.heading'|trans({}, 'sessions') }}</h2>
            <p>{{ 'sessions.sequence.composer.description'|trans({}, 'sessions') }}</p>
        </div>
        <div class="session-composer__add-actions">
            <a class="internal-button internal-button--secondary" href="{{ path('session_sequence_new', { uuid: session.uuid, composer: 1 }) }}" data-turbo-frame="session-composer-overlay">
                {{ 'sessions.sequence.composer.add_activity'|trans({}, 'sessions') }}
            </a>
            <a class="internal-button" href="{{ path('session_composer_add', { uuid: session.uuid }) }}" data-turbo-frame="session-composer-overlay">
                {{ 'sessions.sequence.composer.add'|trans({}, 'sessions') }}
            </a>
        </div>
    </div>

    <p class="session-composer__status" aria-live="polite" data-session-sequence-sorter-target="status"></p>

    {% if session.sequences is empty %}
        <div class="internal-empty-state">{{ 'sessions.sequence.index.empty'|trans({}, 'sessions') }}</div>
    {% else %}
        <div class="session-composer__list" data-session-sequence-sorter-target="list">
            {% for sequence in session.sequences %}
                <article class="session-composer__card" draggable="true" data-session-sequence-sorter-target="item" data-sequence-uuid="{{ sequence.uuid }}">
                    <div class="session-composer__drag-handle" aria-hidden="true">⠿</div>
                    <div class="session-composer__content">
                        <twig:SessionSequenceLocalDetails sessionUuid="{{ session.uuid }}" sequenceUuid="{{ sequence.uuid }}" section="role" role="{{ sequence.role ?? '' }}" body="{{ sequence.body ?? '' }}" notes="{{ sequence.notes ?? '' }}" />
                        <h3>
                            <span class="session-composer__index" data-session-sequence-sorter-target="index">{{ loop.index }}</span>
                            <a href="{{ path('session_sequence_edit', { uuid: session.uuid, sequenceUuid: sequence.uuid, composer: 1 }) }}" data-turbo-frame="session-composer-overlay" draggable="false">{{ sequence.title }}</a>
                            {% if sequence.subtitle %}<span class="session-composer__source">— {{ sequence.subtitle }}</span>{% endif %}
                            <span class="session-composer__type">{{ sequence.type.translationKey()|trans({}, 'sessions') }}</span>
                        </h3>
                        <twig:SessionSequenceLocalDetails sessionUuid="{{ session.uuid }}" sequenceUuid="{{ sequence.uuid }}" section="details" role="{{ sequence.role ?? '' }}" body="{{ sequence.body ?? '' }}" notes="{{ sequence.notes ?? '' }}" />
                    </div>
                    <twig:SessionSequenceLocalDetails sessionUuid="{{ session.uuid }}" sequenceUuid="{{ sequence.uuid }}" section="notes" role="{{ sequence.role ?? '' }}" body="{{ sequence.body ?? '' }}" notes="{{ sequence.notes ?? '' }}" />
                    <div class="session-composer__actions">
                        <div class="session-composer__utility-actions">
                            <a class="internal-icon-button" href="{{ path('session_sequence_edit', { uuid: session.uuid, sequenceUuid: sequence.uuid, composer: 1 }) }}" data-turbo-frame="session-composer-overlay" title="{{ 'sessions.sequence.composer.edit'|trans({}, 'sessions') }}" aria-label="{{ 'sessions.sequence.composer.edit'|trans({}, 'sessions') }}">✎</a>
                            <button
                                type="button"
                                class="internal-icon-button internal-icon-button--danger"
                                title="{{ 'sessions.sequence.composer.remove'|trans({}, 'sessions') }}"
                                aria-label="{{ 'sessions.sequence.composer.remove'|trans({}, 'sessions') }}"
                                {{ stimulus_action('confirmation-dialog', 'open') }}
                                data-confirmation-dialog-action-value="{{ path('session_sequence_remove', { uuid: session.uuid, sequenceUuid: sequence.uuid }) }}"
                                data-confirmation-dialog-item-value="{{ sequence.title }}"
                                data-confirmation-dialog-token-value="{{ csrf_token('session_sequence_remove_' ~ sequence.uuid) }}"
                            >🗑</button>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
        <div class="session-composer__add-actions session-composer__bottom-action">
            <a class="internal-button internal-button--secondary" href="{{ path('session_sequence_new', { uuid: session.uuid, composer: 1 }) }}" data-turbo-frame="session-composer-overlay">
                {{ 'sessions.sequence.composer.add_activity'|trans({}, 'sessions') }}
            </a>
            <a class="internal-button" href="{{ path('session_composer_add', { uuid: session.uuid }) }}" data-turbo-frame="session-composer-overlay">
                {{ 'sessions.sequence.composer.add'|trans({}, 'sessions') }}
            </a>
        </div>
    {% endif %}
</section>
