{% extends 'internal/base.html.twig' %}

{% set title = sequence ? 'sessions.sequence.edit.title'|trans({ title: sequence.title }, 'sessions') : 'sessions.sequence.new.title'|trans({}, 'sessions') %}

{% block internal_body %}
    {% include 'components/_internal_back_button.html.twig' with { href: path('session_edit', { uuid: session.uuid }), label: 'sessions.sequence.form.back'|trans({}, 'sessions') } only %}
    <section class="internal-page-heading">
        <div>
            <p class="internal-eyebrow">{{ (sequence ? 'sessions.sequence.edit.eyebrow' : 'sessions.sequence.new.eyebrow')|trans({}, 'sessions') }}</p>
            <h1>{{ sequence ? sequence.title : 'sessions.sequence.new.heading'|trans({}, 'sessions') }}</h1>
            <p>{{ (sequence ? 'sessions.sequence.edit.description' : 'sessions.sequence.new.description')|trans({}, 'sessions') }}</p>
        </div>
    </section>

    <section class="internal-card" data-controller="media-create-dialog">
        {% if hasErrors %}
            <div class="internal-alert internal-alert--error">{{ 'sessions.sequence.form.error_notice'|trans({}, 'sessions') }}</div>
        {% endif %}

        {% if form.vars.value.sourceTitle %}
            <div class="internal-alert internal-alert--success">
                {{ 'sessions.sequence.form.imported_from'|trans({ title: form.vars.value.sourceTitle }, 'sessions') }}
            </div>
        {% endif %}

        {{ form_start(form, { attr: { class: 'internal-form' } }) }}
            <div class="internal-form__grid">
                {{ form_row(form.title) }}
            </div>

            {{ form_row(form.instrumentUuids) }}
            {{ form_row(form.role) }}
            {% include 'session/_role_suggestions.html.twig' with { id: 'session-sequence-role-suggestions' } only %}
            {{ form_row(form.subtitle) }}
            {{ form_row(form.body) }}
            <details class="internal-disclosure"><summary>{{ 'sessions.sequence.form.lyrics_and_gestures'|trans({}, 'sessions') }}</summary>
                {{ form_row(form.lyrics) }}
                {{ form_row(form.gestures) }}
            </details>

            {% include 'media_resource/_association_picker.html.twig' with { field: form.catalogMediaUuids } only %}
            {{ form_row(form.showLyricsByDefault) }}

            {{ form_widget(form.sourceUuid) }}
            {{ form_widget(form.sourceTitle) }}

            <div class="internal-form__actions">
                <a class="internal-button internal-button--secondary internal-form__back-action" href="{{ path('session_edit', { uuid: session.uuid }) }}">{{ 'sessions.sequence.form.back'|trans({}, 'sessions') }}</a>
                {{ form_widget(form.submit) }}
            </div>
        {{ form_end(form) }}
        <dialog class="internal-form-dialog media-create-dialog" data-media-create-dialog-target="dialog" data-action="click->media-create-dialog#closeOnBackdrop"><div class="internal-form-dialog__panel">
            <button type="button" class="internal-icon-button" data-action="media-create-dialog#close" aria-label="{{ 'sessions.sequence.composer.close'|trans({}, 'sessions') }}">×</button>
            <turbo-frame id="media-resource-create"></turbo-frame>
        </div></dialog>
    </section>
{% endblock %}
