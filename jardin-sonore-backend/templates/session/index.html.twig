{% extends 'internal/base.html.twig' %}

{% set title = 'sessions.summary.index.title'|trans({}, 'sessions') %}

{% block internal_body %}
    <section class="internal-page-heading session-index-heading">
        <div>
            <p class="internal-eyebrow">{{ 'sessions.summary.index.eyebrow'|trans({}, 'sessions') }}</p>
            <h1>{{ 'sessions.summary.index.heading'|trans({}, 'sessions') }}</h1>
            <p>{{ 'sessions.summary.index.description'|trans({}, 'sessions') }}</p>
        </div>
        <div class="internal-heading-actions">
            <a class="internal-button internal-button--secondary" href="{{ path('session_family_new') }}">{{ 'sessions.family.create'|trans({}, 'sessions') }}</a>
            <form method="post" action="{{ path('session_documents_regenerate') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('session_documents_regenerate') }}">
                <button class="internal-button internal-button--secondary" type="submit">{{ 'sessions.summary.index.regenerate_documents'|trans({}, 'sessions') }}</button>
            </form>
            <a class="internal-button" href="{{ path('session_new') }}">{{ 'sessions.summary.index.create'|trans({}, 'sessions') }}</a>
        </div>
    </section>

    <section class="internal-card" data-controller="auto-filter">
        <form class="internal-search" method="get" data-auto-filter-target="form" data-action="input->auto-filter#schedule change->auto-filter#change submit->auto-filter#submit">
            <div class="internal-search__row">
                <div class="internal-search__field">
                    <label for="session-query">{{ 'sessions.summary.index.search'|trans({}, 'sessions') }}</label>
                    <input id="session-query" name="query" value="{{ query }}">
                </div>
                <div class="internal-search__field internal-search__field--compact">
                    <label for="session-publication">{{ 'sessions.summary.table.publication'|trans({}, 'sessions') }}</label>
                    <select id="session-publication" name="publication">
                        <option value="">{{ 'sessions.summary.index.all_publication'|trans({}, 'sessions') }}</option>
                        <option value="published" {{ publicationFilter == 'published' ? 'selected' : '' }}>{{ 'sessions.summary.index.published_only'|trans({}, 'sessions') }}</option>
                        <option value="unpublished" {{ publicationFilter == 'unpublished' ? 'selected' : '' }}>{{ 'sessions.summary.index.unpublished_only'|trans({}, 'sessions') }}</option>
                    </select>
                </div>
                <div class="internal-search__field internal-search__field--compact">
                    <label for="session-theme">{{ 'sessions.summary.table.themes'|trans({}, 'sessions') }}</label>
                    <select id="session-theme" name="theme">
                        <option value="">{{ 'sessions.summary.index.all_themes'|trans({}, 'sessions') }}</option>
                        {% for themeOption in themes %}
                            <option value="{{ themeOption.uuid.toRfc4122 }}" {{ themeUuid == themeOption.uuid.toRfc4122 ? 'selected' : '' }}>{{ themeOption.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="internal-search__field internal-search__field--compact">
                    <label for="session-family-filter">{{ 'sessions.family.assignment'|trans({}, 'sessions') }}</label>
                    <select id="session-family-filter" name="family">
                        <option value="">{{ 'sessions.family.all'|trans({}, 'sessions') }}</option>
                        <option value="none" {{ familyFilter == 'none' ? 'selected' : '' }}>{{ 'sessions.family.none'|trans({}, 'sessions') }}</option>
                        {% for family in familyOptions %}<option value="{{ family.uuid }}" {{ familyFilter == family.uuid.toRfc4122 ? 'selected' : '' }}>{{ family.name }}</option>{% endfor %}
                    </select>
                </div>
            </div>
        </form>

        <div data-auto-filter-target="results" aria-live="polite">
            {% if sessions is empty and visibleFamilies is empty %}
                <p class="internal-empty-state">{{ 'sessions.summary.index.empty'|trans({}, 'sessions') }}</p>
            {% else %}
                <div class="internal-table-wrapper">
                    <twig:TableMobileSort label="Trier les séances" :selected="tableSort.column" :options="[
                        { value: 'sessionDate', label: 'Date', href: path('session_index', { query: query, publication: publicationFilter, theme: themeUuid, family: familyFilter, sort: 'sessionDate', direction: tableSort.nextDirectionFor('sessionDate') }) },
                        { value: 'title', label: 'Titre', href: path('session_index', { query: query, publication: publicationFilter, theme: themeUuid, family: familyFilter, sort: 'title', direction: tableSort.nextDirectionFor('title') }) }
                    ]" />
                    <table class="internal-table internal-table--compact-mobile session-index-table">
                        <colgroup><col><col><col><col><col></colgroup>
                        <thead>
                            <tr>
                                <th><twig:TableSortHeader label="{{ 'sessions.summary.table.title'|trans({}, 'sessions') }}" :href="path('session_index', { query: query, publication: publicationFilter, theme: themeUuid, family: familyFilter, sort: 'title', direction: tableSort.nextDirectionFor('title') })" :active="tableSort.column == 'title'" :direction="tableSort.direction" /></th>
                                <th><twig:TableSortHeader label="{{ 'sessions.summary.table.date'|trans({}, 'sessions') }}" :href="path('session_index', { query: query, publication: publicationFilter, theme: themeUuid, family: familyFilter, sort: 'sessionDate', direction: tableSort.nextDirectionFor('sessionDate') })" :active="tableSort.column == 'sessionDate'" :direction="tableSort.direction" /></th>
                                <th>{{ 'sessions.summary.table.themes'|trans({}, 'sessions') }}</th>
                                <th>{{ 'sessions.summary.table.publication'|trans({}, 'sessions') }}</th>
                                <th>{{ 'sessions.summary.table.actions'|trans({}, 'sessions') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for family in visibleFamilies %}
                                {% set familySessions = sessionsByFamily[family.uuid.toRfc4122] ?? [] %}
                                <tr class="session-index-family-row"><td colspan="5">
                                    <details class="session-index-family" {{ query ? 'open' : '' }}>
                                        <summary>
                                            <span class="session-index-family__identity"><span class="session-index-family__name">{{ family.name }}</span><span class="session-index-family__count">{{ familySessions|length }} {{ 'sessions.family.variants'|trans({}, 'sessions')|lower }}</span></span>
                                            <span class="instrument-catalog__tags session-index-family__themes">{% for theme in family.themes %}<span class="internal-badge internal-badge--color" style="--badge-color: {{ theme.color }}">{{ theme.label }}</span>{% endfor %}</span>
                                        </summary>
                                        <a class="internal-icon-button session-index-family__action" href="{{ path('session_family_show', {uuid: family.uuid}) }}" title="{{ 'sessions.family.open'|trans({}, 'sessions') }}" aria-label="{{ 'sessions.family.open'|trans({}, 'sessions') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'edit'} only %}</a>
                                        <div class="session-index-family__content">
                                            {% if familySessions is not empty %}<table class="internal-table internal-table--compact-mobile session-index-table"><colgroup><col><col><col><col><col></colgroup><tbody>{% for session in familySessions %}{% include 'session/_index_row.html.twig' %}{% endfor %}</tbody></table>{% endif %}
                                        </div>
                                    </details>
                                </td></tr>
                            {% endfor %}
                            {% for session in unassignedSessions %}
                                {% include 'session/_index_row.html.twig' %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
