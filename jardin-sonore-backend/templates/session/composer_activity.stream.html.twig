<turbo-stream action="replace" target="session-composer">
    <template>{% include 'session/_composer.html.twig' with { session: session } only %}</template>
</turbo-stream>
{% if summaryForm is defined %}
    <turbo-stream action="replace" target="session-summary-edit-form">
        <template>
            <section id="session-summary-edit-form" class="internal-card internal-card--form session-summary-edit-form">
                {% include 'session/_summary_form.html.twig' with {
                    form: summaryForm,
                    backPath: path('session_index'),
                    backLabel: 'sessions.summary.edit.back'|trans({}, 'sessions'),
                } only %}
            </section>
        </template>
    </turbo-stream>
{% endif %}
{% if sequenceUuid is defined %}
    <turbo-stream action="replace" target="session-composer-overlay"><template><turbo-frame id="session-composer-overlay" src="{{ path('session_sequence_edit', { uuid: session.uuid, sequenceUuid: sequenceUuid, composer: 1 }) }}"></turbo-frame></template></turbo-stream>
{% else %}
    <turbo-stream action="update" target="session-composer-overlay"><template></template></turbo-stream>
{% endif %}
