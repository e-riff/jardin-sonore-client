{% extends 'internal/base.html.twig' %}
{% set title = 'subscriber.title'|trans({}, 'newsletter') %}
{% block internal_body %}
    {% include 'components/_internal_back_button.html.twig' with { href: emailsUrl, label: 'subscriber.back'|trans({}, 'newsletter') } only %}
    <section class="internal-page-heading">
        <div><p class="internal-eyebrow">{{ 'subscriber.eyebrow'|trans({}, 'newsletter') }}</p><h1>{{ title }}</h1><p>{{ 'subscriber.description'|trans({}, 'newsletter') }}</p></div>
    </section>
    <section class="internal-card internal-card--form subscriber-management-card">
        {% if emailContact %}
            {% set linkedCount = emailContact.emailContactLinks|filter(link => link.active)|length %}
            {% set pendingConfirmation = confirmationPending %}
            {% set subscribed = emailContact.active and not emailContact.newsletterRefused and (emailContact.directoryMailingAllowed or emailContact.freeNewsletterSubscription) and not pendingConfirmation %}
            {% set state = not emailContact.active ? 'inactive' : (emailContact.newsletterRefused ? 'unsubscribed' : (pendingConfirmation ? 'pending' : (not subscribed ? 'not_subscribed' : 'subscribed'))) %}
            <p class="subscriber-management-card__status"><span class="internal-badge internal-badge--{{ subscribed ? 'success' : (state == 'unsubscribed' ? 'danger' : (state == 'pending' ? 'warning' : 'muted')) }}">{{ ('subscriber.status.' ~ state)|trans({}, 'newsletter') }}</span></p>
            {% if linkedCount > 0 %}
                <div class="internal-alert subscriber-management-card__scope">
                    <p>{{ 'subscriber.shared_address'|trans({count: linkedCount}, 'newsletter') }}</p>
                    <a href="{{ path('internal_directory_index', {query: emailContact.emailAddress}) }}">{{ 'subscriber.index.linked_count'|trans({count: linkedCount}, 'newsletter') }}</a>
                </div>
            {% endif %}
            {% if state == 'inactive' %}<div class="internal-alert internal-alert--error">{{ 'subscriber.blocked'|trans({}, 'newsletter') }}</div>{% endif %}
            {% if subscribed %}<p class="subscriber-management-card__correction">{{ 'subscriber.address_correction'|trans({}, 'newsletter') }} <a href="{{ path('newsletter_subscriber_new') }}">{{ 'subscriber.add_corrected'|trans({}, 'newsletter') }}</a></p>{% endif %}
        {% endif %}
        {% if not emailContact or ((not emailContact.freeNewsletterSubscription or not emailContact.freeNewsletterSubscriptionConfirmedAt or emailContact.newsletterRefused) and state != 'inactive') %}
            <div class="subscriber-management-card__form-section">
                <h2>{{ (emailContact ? 'subscriber.form.reactivate_heading' : 'subscriber.form.add_heading')|trans({}, 'newsletter') }}</h2>
                {{ form_start(form, {attr: {class: 'internal-form subscriber-management-form'}}) }}
                    {{ form_row(form.emailAddress) }}
                    {{ form_row(form.consentAttested, {row_attr: {class: 'internal-form__checkbox'}}) }}
                    {{ form_errors(form) }}
                    <div class="internal-form__actions">{{ form_widget(form.submit) }}</div>
                {{ form_end(form) }}
            </div>
        {% endif %}
        {% if emailContact and emailContact.active and not emailContact.newsletterRefused and (emailContact.directoryMailingAllowed or emailContact.freeNewsletterSubscription) %}
            <form class="subscriber-management-card__unsubscribe" method="post" action="{{ path('newsletter_subscriber_unsubscribe', {uuid: emailContact.uuid}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('newsletter_unsubscribe_' ~ emailContact.uuid) }}">
                <button type="submit" id="newsletter-unsubscribe" class="internal-button internal-button--danger">{{ 'subscriber.unsubscribe'|trans({}, 'newsletter') }}</button>
                <p>{{ 'subscriber.unsubscribe_help'|trans({}, 'newsletter') }}</p>
            </form>
        {% endif %}
        {% if emailContact %}
            <h2>{{ 'preferences.title'|trans({}, 'newsletter') }}</h2>
            <p>{{ (emailContact.directoryMailingAllowed ? 'preferences.directory_allowed' : 'preferences.directory_blocked')|trans({}, 'newsletter') }}</p>
            <p>{{ (emailContact.freeNewsletterSubscription ? 'preferences.explicit_subscription' : 'preferences.no_explicit_subscription')|trans({}, 'newsletter') }}</p>
            <p>{{ (emailContact.newsletterRefused ? 'preferences.newsletter_stopped' : 'preferences.newsletter_available')|trans({}, 'newsletter') }}{% if emailContact.newsletterRefused %} · {{ emailContact.newsletterRefusedAt ? emailContact.newsletterRefusedAt|date('d/m/Y') : 'preferences.unknown_date'|trans({}, 'newsletter') }}{% endif %}</p>
            <p>{{ (emailContact.outreachRefused ? 'preferences.outreach_stopped' : 'preferences.outreach_available')|trans({}, 'newsletter') }}{% if emailContact.outreachRefused %} · {{ emailContact.outreachRefusedAt ? emailContact.outreachRefusedAt|date('d/m/Y') : 'preferences.unknown_date'|trans({}, 'newsletter') }}{% endif %}</p>
            {% if not emailContact.directoryMailingAllowed %}
                <div data-controller="internal-dialog">
                    <button type="button" class="internal-button internal-button--secondary" data-action="internal-dialog#open">{{ 'preferences.allow_directory'|trans({}, 'newsletter') }}</button>
                    <dialog class="internal-form-dialog" data-internal-dialog-target="dialog" data-action="click->internal-dialog#closeOnBackdrop" aria-labelledby="directory-permission-title">
                        <div class="internal-form-dialog__panel">
                            <h2 id="directory-permission-title">{{ 'preferences.allow_directory'|trans({}, 'newsletter') }}</h2>
                            <p>{{ 'preferences.directory_help'|trans({}, 'newsletter') }}</p>
                            <form method="post" class="internal-form" action="{{ path('newsletter_subscriber_preferences', {uuid: emailContact.uuid}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_preferences_' ~ emailContact.uuid.toRfc4122) }}">
                                <input type="hidden" name="action" value="allow_directory">
                                <input type="hidden" name="confirmed" value="1">
                                <div class="internal-form__actions">
                                    <button type="button" class="internal-button internal-button--secondary" data-action="internal-dialog#close">{{ 'preferences.cancel'|trans({}, 'newsletter') }}</button>
                                    <button class="internal-button" type="submit">{{ 'preferences.allow_directory'|trans({}, 'newsletter') }}</button>
                                </div>
                            </form>
                        </div>
                    </dialog>
                </div>
            {% endif %}
            <form method="post" class="internal-form" action="{{ path('newsletter_subscriber_preferences', {uuid: emailContact.uuid}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_preferences_' ~ emailContact.uuid.toRfc4122) }}">
                <div class="internal-form__actions">

                    <button class="internal-button internal-button--secondary" name="action" value="{{ emailContact.outreachRefused ? 'allow_outreach' : 'stop_outreach' }}">{{ (emailContact.outreachRefused ? 'preferences.allow_outreach' : 'preferences.stop_outreach')|trans({}, 'newsletter') }}</button>
                    <button class="internal-button internal-button--secondary" name="action" value="stop_all">{{ 'preferences.stop_all'|trans({}, 'newsletter') }}</button>
                </div>
                <p>{{ 'preferences.directory_help'|trans({}, 'newsletter') }}</p>
            </form>
        {% endif %}
    </section>
{% endblock %}
