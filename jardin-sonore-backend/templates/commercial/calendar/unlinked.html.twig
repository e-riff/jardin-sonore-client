{% extends 'internal/base.html.twig' %}

{% set title = 'calendar.unlinked.heading'|trans({}, 'commercial') %}

{% block internal_body %}
    {% include 'components/_internal_back_button.html.twig' with { href: path('commercial_project_index'), label: 'project.back'|trans({}, 'commercial') } only %}
    <section class="internal-hero">
        <h1>{{ 'calendar.unlinked.heading'|trans({}, 'commercial') }}</h1>
        <p>{{ 'calendar.unlinked.description'|trans({}, 'commercial') }}</p>
        <form method="get" action="{{ path('commercial_calendar_unlinked') }}" class="internal-form">
            <label>{{ 'calendar.unlinked.from'|trans({}, 'commercial') }} <input type="date" name="from" value="{{ from }}" required></label>
            <label>{{ 'calendar.unlinked.to'|trans({}, 'commercial') }} <input type="date" name="to" value="{{ (to|date_modify('-1 day'))|date('Y-m-d') }}" required></label>
            <button class="internal-button internal-button--secondary" type="submit">{{ 'calendar.unlinked.search'|trans({}, 'commercial') }}</button>
        </form>
    </section>

    {% if calendarError %}
        <p class="internal-card" role="alert">{{ 'calendar.unlinked.load_error'|trans({}, 'commercial') }}</p>
    {% elseif groups is empty %}
        <p class="internal-card">{{ 'calendar.unlinked.empty'|trans({}, 'commercial') }}</p>
    {% else %}
        <div class="commercial-calendar-groups">
            {% for group in groups %}
                <section class="internal-card">
                    <h2>{{ group[0].title }}</h2>
                    {% if group|length > 1 %}<p>{{ 'calendar.unlinked.group_count'|trans({'%count%': group|length}, 'commercial') }}</p>{% endif %}
                    <form method="post" action="{{ path('commercial_calendar_attach') }}" class="internal-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('commercial_calendar_attach') }}">
                        <input type="hidden" name="from" value="{{ from }}">
                        <input type="hidden" name="to" value="{{ (to|date_modify('-1 day'))|date('Y-m-d') }}">
                        <fieldset class="commercial-calendar-group__events">
                            <legend>{{ 'calendar.unlinked.choose_sessions'|trans({}, 'commercial') }}</legend>
                            <div class="internal-form__choice-list">
                            {% for event in group %}
                                <label class="internal-form__choice">
                                    <input class="internal-form__choice-input" type="checkbox" name="event_ids[]" value="{{ event.id }}"{% if event.allDay %} disabled{% endif %}>
                                    <span class="internal-form__choice-label">
                                        <strong>{% if event.allDay %}{{ event.startsAt|date('d/m/Y', 'Europe/Paris') }}{% else %}{{ event.startsAt|date('d/m/Y H:i', 'Europe/Paris') }}–{{ event.endsAt|date('H:i', 'Europe/Paris') }}{% endif %}</strong>
                                        {% if event.title != group[0].title %} · {{ event.title }}{% endif %}
                                        {% if event.location %}<br>{{ event.location }}{% endif %}
                                        {% if event.allDay %}<br><small>{{ 'calendar.unlinked.all_day'|trans({}, 'commercial') }}</small>{% endif %}
                                    </span>
                                </label>
                            {% endfor %}
                            </div>
                        </fieldset>
                        <label>{{ 'calendar.unlinked.project'|trans({}, 'commercial') }}
                            <select name="project_id" required>
                                <option value="">{{ 'calendar.unlinked.choose_project'|trans({}, 'commercial') }}</option>
                                {% for project in projects %}
                                    <option value="{{ project.id }}">{{ project.title }}{% if project.organization %} · {{ project.organization.name }}{% endif %}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label>{{ 'calendar.unlinked.status'|trans({}, 'commercial') }}
                            <select name="status" required>
                                <option value="option">{{ 'calendar.status.option'|trans({}, 'commercial') }}</option>
                                <option value="confirmed">{{ 'calendar.status.confirmed'|trans({}, 'commercial') }}</option>
                            </select>
                        </label>
                        <button class="internal-button" type="submit">{{ 'calendar.unlinked.attach'|trans({}, 'commercial') }}</button>
                    </form>
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
