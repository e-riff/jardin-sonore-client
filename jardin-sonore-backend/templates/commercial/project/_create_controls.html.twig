<div class="commercial-dossier__create-controls" data-controller="internal-dialog" data-internal-dialog-open-on-connect-value="{{ (noteError is defined or noteForm.vars.submitted) ? 'true' : 'false' }}">
    <button type="button" class="internal-button internal-button--secondary internal-button--compact commercial-dossier__create-event" aria-haspopup="dialog" aria-controls="commercial-project-note-dialog-{{ project.id }}" {{ stimulus_action('internal-dialog', 'open') }}>{% include 'commercial/project/_icon.html.twig' with {name: 'note'} only %} {{ 'project.add_event'|trans({}, 'commercial') }}</button>
    <dialog id="commercial-project-note-dialog-{{ project.id }}" class="internal-form-dialog" aria-labelledby="commercial-project-note-title-{{ project.id }}" {{ stimulus_target('internal-dialog', 'dialog') }} {{ stimulus_action('internal-dialog', 'closeOnBackdrop', 'click') }}>
        <div class="internal-form-dialog__panel">
            <button type="button" class="internal-form-dialog__close" aria-label="{{ 'internal.confirmation.delete.close'|trans({}, 'internal') }}" title="{{ 'internal.confirmation.delete.close'|trans({}, 'internal') }}" {{ stimulus_action('internal-dialog', 'close') }}>×</button>
            <h2 id="commercial-project-note-title-{{ project.id }}">{{ 'project.add_event'|trans({}, 'commercial') }}</h2>
            {% if noteError is defined %}<p class="internal-alert" role="alert">{{ noteError|trans({}, 'commercial') }}</p>{% endif %}
        {{ form_start(noteForm, {action: path('commercial_project_note', {id: project.id}), attr: {
            class: 'internal-form',
            'data-controller': 'commercial-note-draft',
            'data-commercial-note-draft-project-id-value': project.id,
            'data-action': 'input->commercial-note-draft#save change->commercial-note-draft#save turbo:submit-end->commercial-note-draft#submitted',
        }}) }}
            <p class="commercial-dossier__create-hint">{{ 'project.add_event_hint'|trans({}, 'commercial') }}</p>
            {{ form_row(noteForm.content) }}
            {{ form_row(noteForm.occurredOn) }}
            {{ form_row(noteForm.person) }}
            <fieldset class="commercial-note-reminder">
                <legend>{{ 'note.reminder_heading'|trans({}, 'commercial') }}</legend>
                <p>{{ 'note.reminder_hint'|trans({}, 'commercial') }}</p>
                {{ form_row(noteForm.nextActionTitle) }}
                {{ form_row(noteForm.nextActionDueOn) }}
            </fieldset>
            {{ form_row(noteForm.submit) }}
        {{ form_end(noteForm) }}
        </div>
    </dialog>
</div>
