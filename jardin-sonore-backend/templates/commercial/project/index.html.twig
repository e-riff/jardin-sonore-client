{% extends 'internal/base.html.twig' %}

{% set isClosedIndex = app.request.query.get('status') == 'closed' %}
{% set isConfirmedIndex = app.request.query.get('status') == 'confirmed' %}
{% set title = (isClosedIndex ? 'project.list.closed' : (isConfirmedIndex ? 'project.list.confirmed_active' : 'project.list.heading'))|trans({}, 'commercial') %}

{% block internal_body %}
    <section class="internal-hero commercial-project-hero">
        <p class="internal-eyebrow">{{ 'dashboard.eyebrow'|trans({}, 'commercial') }}</p>
        <h1>{{ title }}</h1>
        <p>{{ (isClosedIndex ? 'project.list.closed_intro' : (isConfirmedIndex ? 'project.list.confirmed_intro' : 'project.list.intro'))|trans({}, 'commercial') }}</p>
        <div class="internal-heading-actions">
            <a class="internal-button" href="{{ path('commercial_project_new') }}">{{ 'project.create.heading'|trans({}, 'commercial') }}</a>
            {% if isClosedIndex or isConfirmedIndex %}
                <a class="internal-button internal-button--secondary" href="{{ path('commercial_project_index') }}">{{ 'project.list.back_to_open'|trans({}, 'commercial') }}</a>
            {% else %}
                <a class="internal-button internal-button--secondary" href="{{ path('commercial_project_index', {status: 'confirmed'}) }}">{{ 'project.list.confirmed_active'|trans({}, 'commercial') }}</a>
                <a class="internal-button internal-button--secondary" href="{{ path('commercial_project_index', {status: 'closed'}) }}">{{ 'project.list.closed'|trans({}, 'commercial') }}</a>
            {% endif %}
        </div>
    </section>
    {% if weekInterventions is not empty %}
        <section class="commercial-week" aria-labelledby="commercial-week-heading">
            <h2 id="commercial-week-heading">{{ 'project.list.week_sessions'|trans({}, 'commercial') }} <span class="internal-badge internal-badge--muted">{{ weekInterventions|length }}</span></h2>
            <ul class="commercial-week__list">
                {% for intervention in weekInterventions %}
                    <li class="commercial-week__row"><a class="commercial-week__dossier-link" href="{{ path('commercial_project_show', {id: intervention.project.id}) }}">
                        <time datetime="{{ intervention.startsAt|date('c') }}">{{ intervention.startsAt|date('d/m · H:i', 'Europe/Paris') }}</time>
                        <span class="commercial-week__dossier" title="{{ intervention.project.title }}">{{ intervention.project.organization ? intervention.project.organization.name : intervention.project.title }}</span>
                        {% if intervention.status == 'option' %}<small>{{ 'calendar.status.option'|trans({}, 'commercial') }}</small>{% endif %}
                    </a>{% if intervention.location %}<a class="commercial-week__map" href="https://www.google.com/maps/search/?api=1&amp;query={{ intervention.location|url_encode }}" target="_blank" rel="noopener noreferrer" title="{{ 'technical.directory.open_in_google_maps'|trans({}, 'technical') }} — {{ intervention.location }}" aria-label="{{ 'technical.directory.open_in_google_maps'|trans({}, 'technical') }} — {{ intervention.location }}">{% include 'commercial/project/_icon.html.twig' with {name: 'map'} only %}<span>{{ intervention.location }}</span></a>{% endif %}</li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
    <twig:CommercialProjectTable />
{% endblock %}
