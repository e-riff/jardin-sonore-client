<details class="commercial-dossier__contacts" id="commercial-contacts" data-controller="responsive-details">
    <summary>
        {% include 'commercial/project/_icon.html.twig' with {name: 'people'} only %}
        <span id="commercial-contacts-heading">{{ 'project.contact_heading'|trans({}, 'commercial') }}</span>
        <span class="commercial-dossier__disclosure-chevron" aria-hidden="true"></span>
    </summary>
    <div class="commercial-dossier__contacts-content">
    {% if project.organization %}
        <div class="commercial-dossier__organization">
            <div>
                <span class="commercial-dossier__label">{{ 'project.organization'|trans({}, 'commercial') }}</span>
                <div class="commercial-dossier__record-heading">
                    <strong>{{ project.organization.name }}</strong>
                    <a class="commercial-dossier__icon-action" href="{{ path('internal_directory_index', {section: 'organizations', selectedId: project.organization.id}) }}" title="{{ 'project.open_directory_record'|trans({}, 'commercial') }}" aria-label="{{ 'project.open_directory_record'|trans({}, 'commercial') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'edit'} only %}</a>
                </div>
                {% if project.organization.municipalitySummary and project.organization.municipalitySummary != '—' %}<span class="commercial-dossier__muted">{{ project.organization.municipalitySummary }}</span>{% endif %}
            </div>
            <div class="commercial-dossier__channels">
                {% for phone in project.organization.contactDetails.phoneContacts %}
                    <span class="commercial-dossier__channel"><span class="commercial-contact-value">{{ include('commercial/project/_phone_number.html.twig', {number: phone.phoneNumber}, with_context: false) }}</span><a href="tel:{{ phone.phoneNumber|replace({' ': '', '.': '', '-': ''}) }}" aria-label="{{ 'project.call_number'|trans({number: phone.phoneNumber}, 'commercial') }}" title="{{ 'project.call_number'|trans({number: phone.phoneNumber}, 'commercial') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'phone'} only %}</a></span>
                {% endfor %}
                {% for email in project.organization.contactDetails.emailContacts %}
                    <span class="commercial-dossier__channel"><span class="commercial-contact-value">{{ email.emailAddress }}</span><a href="mailto:{{ email.emailAddress }}" aria-label="{{ 'project.write_address'|trans({address: email.emailAddress}, 'commercial') }}" title="{{ 'project.write_address'|trans({address: email.emailAddress}, 'commercial') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'mail'} only %}</a></span>
                {% endfor %}
            </div>
        </div>
        <details class="commercial-dossier__people" data-controller="commercial-contacts">
            <summary>{{ 'project.people'|trans({}, 'commercial') }} <span class="commercial-dossier__count">{{ project.people|length }}</span>{% if project.primaryContact %}<span class="commercial-dossier__summary-person">{{ project.primaryContact }}</span>{% endif %}</summary>
            {% for projectPerson in project.people %}
                <div class="commercial-dossier__person">
                    <div class="commercial-dossier__person-heading"><strong>{{ projectPerson.person }}</strong><a class="commercial-dossier__icon-action" href="{{ path('internal_directory_index', {section: 'people', selectedId: projectPerson.person.id}) }}" title="{{ 'project.open_directory_record'|trans({}, 'commercial') }}" aria-label="{{ 'project.open_directory_record'|trans({}, 'commercial') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'edit'} only %}</a>{% if project.primaryContact == projectPerson.person %}<span class="commercial-dossier__primary" title="{{ 'project.primary_contact'|trans({}, 'commercial') }}">{{ 'project.primary_contact'|trans({}, 'commercial') }}</span>{% endif %}{% if not projectPerson.current %}<span class="internal-badge internal-badge--muted">{{ 'project.contact_former'|trans({}, 'commercial') }}</span>{% endif %}</div>
                    {% if projectPerson.person.role %}<span class="commercial-dossier__muted">{{ projectPerson.person.role }}</span>{% endif %}
                    {% if projectPerson.current %}
                        <div data-controller="internal-dialog">
                            <button type="button" class="internal-button internal-button--secondary internal-button--compact" data-action="internal-dialog#open" aria-haspopup="dialog">{{ 'project.contact_mark_former'|trans({}, 'commercial') }}</button>
                            <dialog class="internal-form-dialog" data-internal-dialog-target="dialog" data-action="click->internal-dialog#closeOnBackdrop">
                                <div class="internal-form-dialog__panel">
                                    <h2>{{ 'project.contact_former_confirm_title'|trans({}, 'commercial') }}</h2>
                                    <p>{{ 'project.contact_former_confirm_description'|trans({'%name%': projectPerson.person}, 'commercial') }}</p>
                                    <form method="post" action="{{ path('commercial_project_contact_former', {id: project.id, personId: projectPerson.person.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('commercial_project_contact_' ~ project.id ~ '_' ~ projectPerson.person.id ~ '_former') }}">
                                        <div class="internal-form-dialog__actions">
                                            <button type="button" class="internal-button internal-button--secondary" data-action="internal-dialog#close">{{ 'project.contact_former_cancel'|trans({}, 'commercial') }}</button>
                                            <button type="submit" class="internal-button">{{ 'project.contact_mark_former'|trans({}, 'commercial') }}</button>
                                        </div>
                                    </form>
                                </div>
                            </dialog>
                        </div>
                    {% endif %}

                    <div class="commercial-dossier__channels">
                        {% for phone in projectPerson.person.contactDetails.phoneContacts %}
                            <span class="commercial-dossier__channel"><span class="commercial-contact-value">{{ include('commercial/project/_phone_number.html.twig', {number: phone.phoneNumber}, with_context: false) }}</span><a href="tel:{{ phone.phoneNumber|replace({' ': '', '.': '', '-': ''}) }}" aria-label="{{ 'project.call_number'|trans({number: phone.phoneNumber}, 'commercial') }}" title="{{ 'project.call_number'|trans({number: phone.phoneNumber}, 'commercial') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'phone'} only %}</a></span>
                        {% endfor %}
                        {% for email in projectPerson.person.contactDetails.emailContacts %}
                            <span class="commercial-dossier__channel"><span class="commercial-contact-value">{{ email.emailAddress }}</span><a href="mailto:{{ email.emailAddress }}" aria-label="{{ 'project.write_address'|trans({address: email.emailAddress}, 'commercial') }}" title="{{ 'project.write_address'|trans({address: email.emailAddress}, 'commercial') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'mail'} only %}</a></span>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <p class="commercial-dossier__muted">{{ 'project.no_people'|trans({}, 'commercial') }}</p>
            {% endfor %}
            <div class="commercial-dossier__contact-tools" data-controller="internal-dialog">
                <button type="button" class="internal-button internal-button--secondary internal-button--compact" data-action="internal-dialog#open" aria-haspopup="dialog" aria-controls="commercial-contact-dialog-{{ project.id }}">{% include 'commercial/project/_icon.html.twig' with {name: 'people'} only %} {{ 'project.contact_add'|trans({}, 'commercial') }}</button>
                <dialog id="commercial-contact-dialog-{{ project.id }}" class="internal-form-dialog" aria-labelledby="commercial-contact-dialog-title-{{ project.id }}" data-internal-dialog-target="dialog" data-action="click->internal-dialog#closeOnBackdrop">
                    <div class="internal-form-dialog__panel" data-controller="commercial-contact-mode">
                        <button type="button" class="internal-form-dialog__close" data-action="internal-dialog#close" aria-label="{{ 'internal.confirmation.delete.close'|trans({}, 'internal') }}" title="{{ 'internal.confirmation.delete.close'|trans({}, 'internal') }}">×</button>
                        <h2 id="commercial-contact-dialog-title-{{ project.id }}">{{ 'project.contact_add'|trans({}, 'commercial') }}</h2>
                        <div class="internal-form">
                            <fieldset class="internal-form__choices">
                                <legend>{{ 'project.contact_mode'|trans({}, 'commercial') }}</legend>
                                <label class="internal-form__choice"><input class="internal-form__choice-input" type="radio" name="contactMode" value="link" checked data-commercial-contact-mode-target="choice" data-action="change->commercial-contact-mode#change"><span class="internal-form__choice-label">{{ 'project.contact_link'|trans({}, 'commercial') }}</span></label>
                                <label class="internal-form__choice"><input class="internal-form__choice-input" type="radio" name="contactMode" value="create" data-commercial-contact-mode-target="choice" data-action="change->commercial-contact-mode#change"><span class="internal-form__choice-label">{{ 'project.contact_create'|trans({}, 'commercial') }}</span></label>
                            </fieldset>
                        </div>
                        <form method="post" action="{{ path('commercial_project_contact_link', {id: project.id}) }}" class="internal-form" data-commercial-contact-mode-target="linkForm">
                            <input type="hidden" name="_token" value="{{ csrf_token('commercial_project_contact_' ~ project.id ~ '_link') }}">
                            <label for="commercial-contact-person-{{ project.id }}">{{ 'project.contact_person'|trans({}, 'commercial') }}</label>
                            <select id="commercial-contact-person-{{ project.id }}" name="personId" required><option value="">{{ 'project.contact_select'|trans({}, 'commercial') }}</option>{% for person in project.organization.people %}{% if person.active %}<option value="{{ person.id }}">{{ person }}{% if person.role %} — {{ person.role }}{% endif %}</option>{% endif %}{% endfor %}</select>
                            <div class="internal-form__checkbox"><input id="commercial-contact-link-primary-{{ project.id }}" type="checkbox" name="primary" value="1"><label for="commercial-contact-link-primary-{{ project.id }}">{{ 'project.contact_make_primary'|trans({}, 'commercial') }}</label></div>
                            <div class="internal-form-dialog__actions">
                                <button type="button" class="internal-button internal-button--secondary" data-action="internal-dialog#close">{{ 'project.contact_former_cancel'|trans({}, 'commercial') }}</button>
                                <button class="internal-button" type="submit">{{ 'project.contact_link_save'|trans({}, 'commercial') }}</button>
                            </div>
                        </form>
                        <form method="post" action="{{ path('commercial_project_contact_create', {id: project.id}) }}" class="internal-form" data-commercial-contact-mode-target="createForm" hidden>
                            <input type="hidden" name="_token" value="{{ csrf_token('commercial_project_contact_' ~ project.id ~ '_create') }}">
                            <label for="commercial-contact-last-name-{{ project.id }}">{{ 'project.last_name'|trans({}, 'commercial') }}</label><input id="commercial-contact-last-name-{{ project.id }}" name="lastName" autocomplete="family-name" required>
                            <label for="commercial-contact-first-name-{{ project.id }}">{{ 'project.first_name'|trans({}, 'commercial') }}</label><input id="commercial-contact-first-name-{{ project.id }}" name="firstName" autocomplete="given-name" required>
                            <label for="commercial-contact-role-{{ project.id }}">{{ 'project.role'|trans({}, 'commercial') }}</label><input id="commercial-contact-role-{{ project.id }}" name="role" autocomplete="organization-title">
                            <div class="internal-form__checkbox"><input id="commercial-contact-create-primary-{{ project.id }}" type="checkbox" name="primary" value="1"><label for="commercial-contact-create-primary-{{ project.id }}">{{ 'project.contact_make_primary'|trans({}, 'commercial') }}</label></div>
                            <div class="internal-form-dialog__actions">
                                <button type="button" class="internal-button internal-button--secondary" data-action="internal-dialog#close">{{ 'project.contact_former_cancel'|trans({}, 'commercial') }}</button>
                                <button class="internal-button" type="submit">{{ 'project.contact_create_save'|trans({}, 'commercial') }}</button>
                            </div>
                        </form>
                    </div>
                </dialog>
            </div>
        </details>
    {% else %}
        <div class="commercial-dossier__organization commercial-dossier__organization--provisional">
            <div><strong>{{ project.request ? (project.request.organizationName ?: project.request.senderName) : project.title }}</strong><span class="commercial-dossier__muted">{{ 'project.create.provisional_hint'|trans({}, 'commercial') }}</span></div>
            {% if project.request %}<div class="commercial-dossier__channels">
                {% if project.request.phone %}<span class="commercial-dossier__channel"><span class="commercial-contact-value">{{ include('commercial/project/_phone_number.html.twig', {number: project.request.phone}, with_context: false) }}</span><a href="tel:{{ project.request.phone|replace({' ': '', '.': '', '-': ''}) }}" aria-label="{{ 'project.call_number'|trans({number: project.request.phone}, 'commercial') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'phone'} only %}</a></span>{% endif %}
                {% if project.request.emailAddress %}<span class="commercial-dossier__channel"><span class="commercial-contact-value">{{ project.request.emailAddress }}</span><a href="mailto:{{ project.request.emailAddress }}" aria-label="{{ 'project.write_address'|trans({address: project.request.emailAddress}, 'commercial') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'mail'} only %}</a></span>{% endif %}
            </div>{% endif %}
        </div>
        {{ form_start(organizationForm, {action: path('commercial_project_organization', {id: project.id}), attr: {class: 'internal-form commercial-dossier__attach'}}) }}
            {{ form_row(organizationForm.organization) }}
            {{ form_row(organizationForm.newOrganizationName) }}
            {{ form_row(organizationForm.submit) }}
        {{ form_end(organizationForm) }}
    {% endif %}
    </div>
</details>
