<section class="commercial-dossier__timeline-header">
    <details class="commercial-dossier__timeline" name="commercial-project-details" aria-labelledby="commercial-timeline-heading" {% if project.status == 'discussion' or noteError is defined or noteForm.vars.submitted %}open{% endif %}>
        <summary>
            {% include 'commercial/project/_icon.html.twig' with {name: 'note'} only %}
            <span id="commercial-timeline-heading">{{ 'project.history'|trans({}, 'commercial') }}</span>
            <span class="commercial-dossier__disclosure-chevron" aria-hidden="true"></span>
        </summary>
        <div class="commercial-dossier__timeline-content">
        <div class="commercial-timeline">
        {% set visibleEvents = project.events|filter(event => not (event.type starts with 'action_') or (event.type == 'action_completed' and event.content|default('')|trim != ''))|sort((left, right) => left.timelineDate <=> right.timelineDate) %}
        {% set latestManualEvent = visibleEvents|reverse|filter(event => not (event.type starts with 'quote_'))|first %}
        {% for event in visibleEvents|reverse %}
            {% set icon = event.type starts with 'action_' ? 'check' : (event.type starts with 'quote_' ? 'quote' : (event.type starts with 'invoice_' ? 'invoice' : (event.type starts with 'contact_' ? 'phone' : 'note'))) %}
            {% set eventIcon = event.type == 'quote_sent' ? 'send' : (event.type == 'quote_signed' ? 'signed' : (event.type == 'quote_refused' ? 'close' : icon)) %}
            {% set eventLabel = ('event.' ~ event.type)|trans({}, 'commercial') %}
            <article class="commercial-timeline__item commercial-timeline__item--{{ icon }}{{ event.type starts with 'quote_' ? ' commercial-timeline__item--quote-' ~ event.type|replace({'quote_': ''}) ~ ' commercial-timeline__item--quote-event' : '' }}{{ event.type == 'action_completed' ? ' commercial-timeline__item--completed' : '' }}" {% if event.content and not (event.type starts with 'quote_') %}data-controller="commercial-timeline" data-commercial-timeline-expanded-value="{{ latestManualEvent and event.id == latestManualEvent.id ? 'true' : 'false' }}" data-commercial-timeline-more-label-value="{{ 'event.show_more'|trans({}, 'commercial') }}" data-commercial-timeline-less-label-value="{{ 'event.show_less'|trans({}, 'commercial') }}"{% endif %}>
                <span class="commercial-timeline__marker" aria-hidden="true"></span>
                <div class="commercial-timeline__heading">
                    {% set timelineDate = event.timelineDate %}
                    <div class="commercial-timeline__event-meta"><time datetime="{{ timelineDate|date('c') }}">{{ timelineDate|date('d/m/Y') }}{% if not (event.type starts with 'quote_') %} <span>· {{ timelineDate|date('H:i') }}</span>{% endif %}</time><h3>{% if event.type starts with 'quote_' %}<span class="commercial-timeline__event-icon commercial-timeline__event-icon--{{ eventIcon }}" aria-hidden="true">{% include 'commercial/project/_icon.html.twig' with {name: eventIcon} only %}</span>{% endif %}{{ eventLabel }}</h3></div>
                    <div class="commercial-timeline__actions">
                    {% if event.type == 'action_completed' and event.action %}
                        <details class="commercial-timeline__edit">
                            <summary class="commercial-dossier__icon-action" title="{{ 'event.edit'|trans({}, 'commercial') }}" aria-label="{{ 'event.edit'|trans({}, 'commercial') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'edit'} only %}</summary>
                            <form method="post" action="{{ path('commercial_action_completed_edit', {id: event.action.id}) }}" class="internal-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('commercial_action_' ~ event.action.id ~ '_completed_edit') }}">
                                <label>{{ 'action.completed_title'|trans({}, 'commercial') }} <input name="title" value="{{ event.action.title }}" maxlength="255" required></label>
                                <label>{{ 'event.date'|trans({}, 'commercial') }} <input type="date" name="occurredOn" value="{{ event.occurredAt|date('Y-m-d') }}" required></label>
                                <label>{{ 'action.note'|trans({}, 'commercial') }} <textarea name="note" maxlength="10000">{{ event.content }}</textarea></label>
                                <button class="internal-button internal-button--secondary" type="submit">{{ 'event.save'|trans({}, 'commercial') }}</button>
                            </form>
                        </details>
                    {% elseif event.type in ['note', 'initial_message'] and event.action is null and event.quote is null and event.invoice is null %}
                        <div data-controller="internal-dialog">
                            <button type="button" class="commercial-dossier__icon-action" title="{{ 'event.edit'|trans({}, 'commercial') }}" aria-label="{{ 'event.edit'|trans({}, 'commercial') }}" aria-haspopup="dialog" aria-controls="commercial-event-edit-dialog-{{ event.id }}" {{ stimulus_action('internal-dialog', 'open') }}>{% include 'commercial/project/_icon.html.twig' with {name: 'edit'} only %}</button>
                            <dialog id="commercial-event-edit-dialog-{{ event.id }}" class="internal-form-dialog commercial-timeline__edit-dialog" aria-labelledby="commercial-event-edit-title-{{ event.id }}" {{ stimulus_target('internal-dialog', 'dialog') }} {{ stimulus_action('internal-dialog', 'closeOnBackdrop', 'click') }}>
                                <div class="internal-form-dialog__panel">
                                    <button type="button" class="internal-form-dialog__close" aria-label="{{ 'internal.confirmation.delete.close'|trans({}, 'internal') }}" title="{{ 'internal.confirmation.delete.close'|trans({}, 'internal') }}" {{ stimulus_action('internal-dialog', 'close') }}>×</button>
                                    <h2 id="commercial-event-edit-title-{{ event.id }}">{{ 'event.edit'|trans({}, 'commercial') }}</h2>
                                    <form method="post" action="{{ path('commercial_project_event_edit', {id: project.id, eventId: event.id}) }}" class="internal-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('commercial_project_' ~ project.id ~ '_event_' ~ event.id ~ '_edit') }}">
                                        {% include 'commercial/project/_rich_text_field.html.twig' with { id: 'commercial-event-content-' ~ event.id, name: 'content', value: event.content, label: 'note.content' } only %}
                                        <label>{{ 'event.date'|trans({}, 'commercial') }} <input type="date" name="occurredOn" value="{{ event.occurredAt|date('Y-m-d') }}" required></label>
                                        <button class="internal-button" type="submit">{{ 'event.save'|trans({}, 'commercial') }}</button>
                                    </form>
                                </div>
                            </dialog>
                        </div>
                    {% endif %}
                        <button type="button" class="commercial-dossier__icon-action commercial-dossier__icon-action--danger" title="{{ 'event.delete'|trans({}, 'commercial') }}" aria-label="{{ 'event.delete'|trans({}, 'commercial') }}" {{ stimulus_action('confirmation-dialog', 'open') }} data-confirmation-dialog-action-value="{{ path('commercial_project_event_delete', {id: project.id, eventId: event.id}) }}" data-confirmation-dialog-item-value="{{ 'event.delete_item'|trans({'%type%': eventLabel, '%date%': event.occurredAt|date('d/m/Y')}, 'commercial') }}" data-confirmation-dialog-token-value="{{ csrf_token('commercial_project_' ~ project.id ~ '_event_' ~ event.id ~ '_delete') }}">{% include 'commercial/project/_icon.html.twig' with {name: 'close'} only %}</button>
                    </div>
                </div>
                {% if event.type == 'action_completed' %}<strong class="commercial-timeline__subject">{{ event.action ? event.action.title : event.metadata.action_title|default('') }}</strong>{% endif %}
                {% if event.person %}<span class="commercial-timeline__person">{% include 'commercial/project/_icon.html.twig' with {name: 'person'} only %}{{ event.person }}</span>{% endif %}
                {% if event.type starts with 'quote_' %}
                    {% if event.content %}<span class="commercial-timeline__quote-reference">{{ event.content }}</span>{% endif %}
                {% endif %}
                {% if event.content and not (event.type starts with 'quote_') %}
                    <div class="commercial-timeline__excerpt" data-commercial-timeline-target="excerpt">{{ event.content|commercial_timeline_rich_text }}</div>
                    <button type="button" class="commercial-timeline__toggle" data-commercial-timeline-target="toggle" data-action="commercial-timeline#toggle" hidden>{{ 'event.show_more'|trans({}, 'commercial') }}</button>
                {% endif %}
                {% if event.type == 'project_status_changed' %}<p class="commercial-timeline__status-change">{{ ('project.status.' ~ event.metadata.old_status)|trans({}, 'commercial') }} → {{ ('project.status.' ~ event.metadata.new_status)|trans({}, 'commercial') }}</p>{% endif %}
            </article>
        {% else %}<p class="commercial-dossier__muted">{{ 'event.none'|trans({}, 'commercial') }}</p>{% endfor %}
        </div>
        </div>
    </details>
    {% include 'commercial/project/_create_controls.html.twig' %}
</section>
