{% set upcomingInterventions = interventions|filter(intervention => intervention.startsAt > date() and intervention.status != 'canceled') %}
{% set optionInterventions = interventions|filter(intervention => intervention.status == 'option') %}
{% set pastInterventions = interventions|filter(intervention => intervention.status == 'canceled' or intervention.startsAt <= date())|reverse %}
{% set organizationAddresses = [] %}
{% set organizationDefaultAddress = '' %}
{% set organizationDefaultAddressIsMain = false %}
{% if project.organization and project.organization.contactDetails %}
    {% for addressContact in project.organization.contactDetails.addressContacts %}
        {% if addressContact.active %}
            {% set municipality = addressContact.municipality %}
            {% set street = addressContact.streetAddress|default('')|trim %}
            {% set postalCode = municipality ? municipality.postalCode|default('')|trim : '' %}
            {% set city = municipality ? municipality.name|default('')|trim : '' %}
            {% set locality = [postalCode, city]|filter(part => part != '')|join(' ') %}
            {% set address = [street, locality]|filter(part => part != '')|join(', ') %}
            {% if address != '' %}
                {% if address not in organizationAddresses %}{% set organizationAddresses = organizationAddresses|merge([address]) %}{% endif %}
                {% set addressIsMain = addressContact.type.value == 'main' %}
                {% if organizationDefaultAddress == '' or (addressIsMain and not organizationDefaultAddressIsMain) %}
                    {% set organizationDefaultAddress = address %}
                    {% set organizationDefaultAddressIsMain = addressIsMain %}
                {% endif %}
            {% endif %}
        {% endif %}
    {% endfor %}
{% endif %}
{% set upcomingByMonth = {} %}
{% for intervention in upcomingInterventions %}
    {% set monthKey = intervention.startsAt|date('Y-m') %}
    {% set upcomingByMonth = upcomingByMonth|merge({(monthKey): (upcomingByMonth[monthKey]|default([]))|merge([intervention])}) %}
{% endfor %}
<div class="commercial-dossier__interventions-shell">
<details class="commercial-dossier__interventions" name="commercial-project-details" {% if project.status == 'confirmed' %}open{% endif %}>
    <summary>
        {% include 'commercial/project/_icon.html.twig' with {name: 'calendar'} only %}
        <span>{{ 'calendar.sessions.heading'|trans({}, 'commercial') }}</span>
        {% if interventions is not empty %}<span class="commercial-dossier__count">{{ upcomingInterventions|length }} {{ 'calendar.sessions.upcoming'|trans({}, 'commercial') }}</span>{% endif %}
        <span class="commercial-dossier__disclosure-chevron" aria-hidden="true"></span>
    </summary>
    <div class="commercial-dossier__interventions-content">
    {% if optionInterventions is not empty %}
        <div class="commercial-dossier__intervention-bulk">
            <span>{{ 'calendar.sessions.bulk_options'|trans({'%count%': optionInterventions|length}, 'commercial') }}</span>
            <form method="post" action="{{ path('commercial_intervention_options_bulk', {projectId: project.id, decision: 'confirm'}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('commercial_project_' ~ project.id ~ '_options_confirm') }}">
                <button class="internal-button internal-button--secondary internal-button--compact" type="submit">{{ 'calendar.sessions.bulk_confirm'|trans({}, 'commercial') }}</button>
            </form>
            <button type="button" class="internal-button internal-button--danger internal-button--compact" {{ stimulus_action('confirmation-dialog', 'open') }} data-confirmation-dialog-action-value="{{ path('commercial_intervention_options_bulk', {projectId: project.id, decision: 'reject'}) }}" data-confirmation-dialog-item-value="{{ 'calendar.sessions.bulk_reject_item'|trans({'%count%': optionInterventions|length}, 'commercial') }}" data-confirmation-dialog-token-value="{{ csrf_token('commercial_project_' ~ project.id ~ '_options_reject') }}">{{ 'calendar.sessions.bulk_reject'|trans({}, 'commercial') }}</button>
        </div>
    {% endif %}
    {% if interventions is empty %}
        <p>{{ 'calendar.sessions.empty'|trans({}, 'commercial') }}</p>
    {% else %}
        {% for monthInterventions in upcomingByMonth %}
            <section class="commercial-dossier__intervention-section commercial-dossier__intervention-month">
                <h3>{{ ('calendar.planner.months.' ~ monthInterventions[0].startsAt|date('n'))|trans({}, 'commercial') }} {{ monthInterventions[0].startsAt|date('Y') }}</h3>
                <ul class="commercial-dossier__intervention-list">
                    {% for intervention in monthInterventions %}
                        {% include 'commercial/project/_intervention_card.html.twig' with {intervention: intervention, project: project, isPast: false} only %}
                    {% endfor %}
                </ul>
            </section>
        {% endfor %}
        {% if pastInterventions is not empty %}
            <section class="commercial-dossier__intervention-section commercial-dossier__past-interventions">
                <h3>{{ 'calendar.sessions.past_heading'|trans({}, 'commercial') }} <span class="commercial-dossier__count">{{ pastInterventions|length }}</span></h3>
                <ul class="commercial-dossier__intervention-list">
                    {% for intervention in pastInterventions %}
                        {% include 'commercial/project/_intervention_card.html.twig' with {intervention: intervention, project: project, isPast: true} only %}
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    {% endif %}
    </div>
</details>
<div class="commercial-dossier__intervention-create" data-controller="internal-dialog commercial-intervention-collection" data-commercial-intervention-collection-next-index-value="1" data-commercial-intervention-collection-max-rows-value="20">
<details class="commercial-dossier__intervention-menu">
    <summary class="internal-button internal-button--secondary internal-button--compact">
        {% include 'commercial/project/_icon.html.twig' with {name: 'calendar'} only %}
        {{ 'calendar.sessions.add'|trans({}, 'commercial') }}
    </summary>
    <div class="commercial-dossier__intervention-menu-options">
        <button type="button" aria-haspopup="dialog" aria-controls="commercial-project-intervention-create-{{ project.id }}" data-action="click->internal-dialog#open click->commercial-intervention-collection#closeMenu">{% include 'commercial/project/_icon.html.twig' with {name: 'calendar'} only %} {{ 'calendar.sessions.create'|trans({}, 'commercial') }}</button>
        <a href="{{ path('commercial_calendar_unlinked') }}">{{ 'calendar.sessions.attach_more'|trans({}, 'commercial') }}</a>
    </div>
</details>
<dialog id="commercial-project-intervention-create-{{ project.id }}" class="internal-form-dialog commercial-intervention-create-dialog" aria-labelledby="commercial-project-intervention-create-title-{{ project.id }}" {{ stimulus_target('internal-dialog', 'dialog') }} {{ stimulus_action('internal-dialog', 'closeOnBackdrop', 'click') }}>
    <div class="internal-form-dialog__panel">
        <button type="button" class="internal-form-dialog__close" aria-label="{{ 'internal.confirmation.delete.close'|trans({}, 'internal') }}" title="{{ 'internal.confirmation.delete.close'|trans({}, 'internal') }}" {{ stimulus_action('internal-dialog', 'close') }}>×</button>
        <p class="internal-eyebrow">{{ project.title }}</p>
        <h2 id="commercial-project-intervention-create-title-{{ project.id }}">{{ 'calendar.sessions.bulk_title'|trans({}, 'commercial') }}</h2>
        <p>{{ 'calendar.sessions.bulk_help'|trans({}, 'commercial') }}</p>
        <form method="post" action="{{ path('commercial_intervention_bulk_create', {projectId: project.id}) }}" class="internal-form commercial-intervention-bulk-form" data-action="submit->commercial-intervention-collection#preventDuplicateSubmit">
            <input type="hidden" name="_token" value="{{ csrf_token('commercial_project_' ~ project.id ~ '_intervention_create') }}">
            <div class="commercial-intervention-bulk-form__rows" data-commercial-intervention-collection-target="rows">
                {% include 'commercial/project/_intervention_create_row.html.twig' with {rowIndex: 0, requestId: '__REQUEST_ID__', defaultAddress: organizationDefaultAddress, organizationAddresses: organizationAddresses} only %}
            </div>
            <template data-commercial-intervention-collection-target="template">{% include 'commercial/project/_intervention_create_row.html.twig' with {rowIndex: '__INDEX__', requestId: '__REQUEST_ID__', defaultAddress: organizationDefaultAddress, organizationAddresses: organizationAddresses} only %}</template>
            <button type="button" class="internal-button internal-button--secondary internal-button--compact commercial-intervention-bulk-form__add" data-action="commercial-intervention-collection#add" data-commercial-intervention-collection-target="addButton">{% include 'commercial/project/_icon.html.twig' with {name: 'plus'} only %} {{ 'calendar.sessions.bulk_add'|trans({}, 'commercial') }}</button>
            <div class="internal-form-dialog__actions">
                <button type="button" class="internal-button internal-button--secondary" {{ stimulus_action('internal-dialog', 'close') }}>{{ 'action.cancel'|trans({}, 'commercial') }}</button>
                <button class="internal-button" type="submit" data-commercial-intervention-collection-target="submit">{% include 'commercial/project/_icon.html.twig' with {name: 'calendar'} only %} {{ 'calendar.sessions.bulk_submit'|trans({}, 'commercial') }}</button>
            </div>
        </form>
    </div>
</dialog>
</div>
</div>
