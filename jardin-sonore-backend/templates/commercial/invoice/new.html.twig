{% extends 'internal/base.html.twig' %}

{% set title = 'invoice.new'|trans({}, 'commercial') %}

{% block internal_body %}
    {% include 'components/_internal_back_button.html.twig' with { href: path('commercial_project_show', {id: project.id}), label: project.title } only %}
    <section class="internal-hero">
        <h1>{{ 'invoice.new'|trans({}, 'commercial') }}</h1>
        <p>{{ 'invoice.hint'|trans({}, 'commercial') }}</p>
    </section>
    <section class="internal-card internal-card--form">
        {% if invoiceError %}<p role="alert">{{ invoiceError|trans({}, 'commercial') }}</p>{% endif %}
        {{ form_start(form, {attr: {class: 'internal-form'}}) }}
            {{ form_row(form.reference) }}
            {{ form_row(form.amount) }}
            {{ form_row(form.issuedOn) }}
            {{ form_row(form.serviceMonth) }}
            <div class="internal-form__actions">{{ form_widget(form.submit) }}</div>
        {{ form_end(form) }}
    </section>
{% endblock %}
