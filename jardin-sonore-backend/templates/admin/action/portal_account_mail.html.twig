{# @var action \EasyCorp\Bundle\EasyAdminBundle\Dto\ActionDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}

{% set csrfId = action.name == 'sendInvitation' ? 'portal_invitation_' : 'portal_password_reset_' %}
<form method="post" action="{{ action.linkUrl }}" class="ea-new-button">
    <input type="hidden" name="_token" value="{{ csrf_token(csrfId ~ entity.primaryKeyValue) }}">
    <button class="btn btn-secondary action-{{ action.name }}" type="submit">
        {% if action.icon %}<i class="action-icon {{ action.icon }}"></i>{% endif %}
        <span class="action-label">{{ action.label|trans|raw }}</span>
    </button>
</form>
