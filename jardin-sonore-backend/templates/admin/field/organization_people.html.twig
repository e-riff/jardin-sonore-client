{% set people = field.formattedValue %}
{% if people is empty %}
    <span>{{ 'admin.field.people_empty'|trans({}, 'backoffice') }}</span>
{% else %}
    <ul class="list-unstyled mb-0">
        {% for person in people %}
            <li>
                <a href="{{ person.detailUrl }}">{{ person.name }}</a>
                {% if person.role is not empty %}
                    <span>— {{ person.role }}</span>
                {% endif %}
                <a href="{{ person.editUrl }}">{{ 'admin.action.edit_person'|trans({}, 'backoffice') }}</a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
