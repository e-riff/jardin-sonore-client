{% if entry.contactDetails %}
    <div class="directory-contact-list">
        {% for link in entry.contactDetails.emailContactLinks %}
            {% if link.active and link.emailAddress %}
                {% set emailContact = link.emailContact %}
                {% set newsletterPending = emailContact and emailContact.freeNewsletterSubscription and not emailContact.freeNewsletterSubscriptionConfirmedAt %}
                {% set newsletterSubscribed = emailContact and emailContact.active and emailContact.optInNewsletter and not emailContact.unsubscribed and not newsletterPending %}
                {% set newsletterState = not emailContact or not emailContact.active ? 'inactive' : (emailContact.unsubscribed ? 'unsubscribed' : (newsletterPending ? 'pending' : (not emailContact.optInNewsletter ? 'not_subscribed' : 'subscribed'))) %}
                <div class="directory-contact-row">
                    <div>
                        <small>{{ link.label ?: ('address_book.email_contact_type.' ~ link.type.value)|trans({}, 'backoffice') }}</small>
                        <div class="directory-contact-email-line">
                            <button type="button" class="directory-contact-value" data-controller="directory-copy" data-directory-copy-value-value="{{ link.emailAddress }}" data-action="directory-copy#copy" title="{{ 'technical.directory.copy_email'|trans({}, 'technical') }}">{{ link.emailAddress }}</button>
                            <a class="internal-badge internal-badge--{{ newsletterSubscribed ? 'success' : (newsletterState == 'unsubscribed' ? 'danger' : (newsletterState == 'pending' ? 'warning' : 'muted')) }} directory-newsletter-badge" href="{{ emailContact ? path('newsletter_subscriber_edit', {uuid: emailContact.uuid}) : path('newsletter_subscriber_index') }}" title="{{ 'subscriber.directory.manage'|trans({}, 'newsletter') }}">{{ ('subscriber.status_short.' ~ newsletterState)|trans({}, 'newsletter') }}</a>
                        </div>
                    </div>
                    <a class="internal-icon-button" href="mailto:{{ link.emailAddress }}" title="{{ 'technical.directory.email'|trans({}, 'technical') }}" aria-label="{{ 'technical.directory.email'|trans({}, 'technical') }} {{ link.emailAddress }}">{% include 'commercial/project/_icon.html.twig' with {name: 'mail'} only %}</a>
                </div>
            {% endif %}
        {% endfor %}
        {% for link in entry.contactDetails.phoneContactLinks %}
            {% if link.active and link.phoneNumber %}
                {% set normalizedPhone = link.phoneNumber|replace({' ': '', '.': '', '-': '', '(': '', ')': ''}) %}
                <div class="directory-contact-row">
                    <div><small>{{ link.label ?: ('address_book.phone_contact_type.' ~ link.type.value)|trans({}, 'backoffice') }}</small><button type="button" class="directory-contact-value" data-controller="directory-copy" data-directory-copy-value-value="{{ normalizedPhone }}" data-action="directory-copy#copy" title="{{ 'technical.directory.copy_phone'|trans({}, 'technical') }}">{{ link.phoneNumber }}</button></div>
                    <a class="internal-icon-button" href="tel:{{ normalizedPhone }}" title="{{ 'technical.directory.call'|trans({}, 'technical') }}" aria-label="{{ 'technical.directory.call'|trans({}, 'technical') }} {{ link.phoneNumber }}">{% include 'commercial/project/_icon.html.twig' with {name: 'phone'} only %}</a>
                </div>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}
