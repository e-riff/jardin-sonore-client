{% extends 'internal/base.html.twig' %}

{% set title = 'catalog.instrument.edit.title'|trans({ name: instrument.name }, 'catalog') %}

{% block internal_body %}
    {% include 'components/_internal_back_button.html.twig' with { href: path('instrument_index'), label: 'catalog.instrument.form.back'|trans({}, 'catalog') } only %}
    <section class="internal-page-heading">
        <div>
            <p class="internal-eyebrow">{{ 'catalog.instrument.edit.eyebrow'|trans({}, 'catalog') }}</p>
            <h1>{{ instrument.name }}</h1>
            <p>{{ 'catalog.instrument.edit.description'|trans({}, 'catalog') }}</p>
        </div>
        <div class="internal-heading-actions">
            <button type="button" class="internal-button internal-button--danger" {{ stimulus_action('confirmation-dialog', 'open') }} data-confirmation-dialog-action-value="{{ path('instrument_delete', { uuid: instrument.uuid.toRfc4122 }) }}" data-confirmation-dialog-item-value="{{ instrument.name }}" data-confirmation-dialog-token-value="{{ csrf_token('instrument_delete_' ~ instrument.uuid.toRfc4122) }}">{{ 'catalog.instrument.table.delete'|trans({}, 'catalog') }}</button>
        </div>
    </section>

    <section class="internal-card internal-card--form">
        {{ include('instrument/_form.html.twig', { form: form, instrument: instrument }) }}
    </section>
{% endblock %}
