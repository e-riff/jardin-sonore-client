{% extends 'internal/base.html.twig' %}

{% set title = 'technical.portal_user.form.new_title'|trans({}, 'technical') %}

{% block internal_body %}
    {% include 'components/_internal_back_button.html.twig' with { href: path('technical_portal_user_index'), label: 'technical.portal_user.detail.back'|trans({}, 'technical') } only %}
    <section class="internal-page-heading">
        <div>
            <p class="internal-eyebrow">{{ 'technical.portal_user.form.new_eyebrow'|trans({}, 'technical') }}</p>
            <h1>{{ 'technical.portal_user.form.new_title'|trans({}, 'technical') }}</h1>
        </div>
    </section>
    <section class="internal-card">
        {{ form_start(form, { attr: { class: 'internal-form internal-form--wide portal-user-create-form' } }) }}
            {{ form_row(form.organizationIdForNewAccess, { attr: form.organizationIdForNewAccess.vars.attr|merge({ placeholder: 'technical.portal_user.form.organization_placeholder'|trans({}, 'technical') }) }) }}
            {{ form_row(form.linkedEmailAddressForNewAccess, { row_attr: { class: 'form-group' } }) }}
            {{ form_row(form.email, { row_attr: { class: 'form-group' } }) }}
            {{ form_row(form.newAccessContactType, { row_attr: { class: 'form-group' } }) }}
            <div class="internal-form__grid">
                {{ form_row(form.newPersonLastNameForNewAccess, { row_attr: { class: 'form-group' } }) }}
                {{ form_row(form.newPersonFirstNameForNewAccess, { row_attr: { class: 'form-group' } }) }}
            </div>
            <div class="internal-form__actions">
                <a class="internal-button internal-button--secondary internal-form__back-action" href="{{ path('technical_portal_user_index') }}">{{ 'technical.portal_user.form.cancel'|trans({}, 'technical') }}</a>
                <button class="internal-button" type="submit">{{ 'technical.portal_user.form.submit'|trans({}, 'technical') }}</button>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
