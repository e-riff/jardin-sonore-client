{% block choice_widget_expanded %}
    {% set attr = attr|merge({
        class: (attr.class|default('') ~ ' internal-form__choice-list')|trim
    }) %}
    <div {{ block('widget_container_attributes') }}>
        {% for child in form %}
            {% set child_attr = child.vars.attr|merge({
                class: (child.vars.attr.class|default('') ~ ' internal-form__choice-input')|trim
            }) %}
            <label class="internal-form__choice">
                {{ form_widget(child, { attr: child_attr }) }}
                <span class="internal-form__choice-label">
                    {{ child.vars.label|trans(
                        child.vars.label_translation_parameters,
                        child.vars.choice_translation_domain ?? form.vars.choice_translation_domain ?? child.vars.translation_domain
                    ) }}
                </span>
            </label>
        {% endfor %}
    </div>
{% endblock %}

{% block checkbox_row %}
    {% set rowClass = (row_attr.class|default('') ~ ' internal-form__checkbox-row')|trim %}
    <div{% with { attr: row_attr|merge({ class: rowClass }) } %}{{ block('attributes') }}{% endwith %}>
        {{ form_errors(form) }}
        <div class="internal-form__checkbox">
            {{ form_widget(form) }}
            {{ form_label(form) }}
        </div>
        {{ form_help(form) }}
    </div>
{% endblock %}

{% block collection_entry_row %}
    {% set rowClass = row_attr.class|default('') %}
    <div{% with { attr: row_attr|merge({ class: rowClass }) } %}{{ block('attributes') }}{% endwith %}>
        {{ form_errors(form) }}
        {{ form_widget(form) }}
        {{ form_help(form) }}
    </div>
{% endblock %}
