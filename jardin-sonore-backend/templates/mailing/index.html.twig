{% extends 'internal/base.html.twig' %}

{% set title = 'mailing.index.title'|trans({}, 'mailing') %}

{% block internal_body %}
    {% set statusBadgeVariants = {
        draft: 'muted',
        ready_for_test: 'primary',
        test_sent: 'secondary',
        delivery_queued: 'warning',
        delivery_sending: 'primary',
        delivery_stopped: 'muted',
        delivery_sent: 'success',
        delivery_failed: 'danger'
    } %}

    <section class="internal-page-heading">
        <div>
            <p class="internal-eyebrow">{{ 'mailing.index.eyebrow'|trans({}, 'mailing') }}</p>
            <h1>{{ 'mailing.index.heading'|trans({}, 'mailing') }}</h1>
            <p>{{ 'mailing.index.description'|trans({}, 'mailing') }}</p>
        </div>
        <div class="internal-heading-actions">
            <a class="internal-button internal-button--secondary" href="{{ path('mailing_invalid_recipients_index') }}">
                {{ 'mailing.index.invalid_recipients'|trans({}, 'mailing') }}
            </a>
            <a class="internal-button" href="{{ path('mailing_new') }}">{{ 'mailing.index.create'|trans({}, 'mailing') }}</a>
        </div>
    </section>

    <section class="internal-card" data-controller="auto-filter">
        <h2>{{ 'mailing.index.list.title'|trans({}, 'mailing') }}</h2>

        <form class="internal-search" method="get" data-auto-filter-target="form" data-action="input->auto-filter#schedule change->auto-filter#change submit->auto-filter#submit">
            <div class="internal-search__row">
                <div class="internal-search__field">
                    <label for="mailing-query">{{ 'mailing.index.search'|trans({}, 'mailing') }}</label>
                    <input id="mailing-query" name="query" value="{{ query }}" type="search" autocomplete="off">
                </div>
                <div class="internal-search__field internal-search__field--compact">
                    <label for="mailing-status">{{ 'mailing.index.filter_status'|trans({}, 'mailing') }}</label>
                    <select id="mailing-status" name="status">
                        <option value="">{{ 'mailing.index.all_statuses'|trans({}, 'mailing') }}</option>
                        {% for status in statuses %}
                            <option value="{{ status.value }}" {{ statusFilter == status.value ? 'selected' : '' }}>{{ ('mailing.status.' ~ status.value)|trans({}, 'mailing') }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </form>

        <div data-auto-filter-target="results" aria-live="polite">
            {% if campaigns is empty %}
                <div class="internal-empty">
                    <p>{{ (query or statusFilter ? 'mailing.index.empty_filtered' : 'mailing.index.empty')|trans({}, 'mailing') }}</p>
                    {% if not query and not statusFilter %}<a class="internal-button" href="{{ path('mailing_new') }}">{{ 'mailing.index.empty_action'|trans({}, 'mailing') }}</a>{% endif %}
                </div>
            {% else %}
                <div class="internal-table-wrapper">
                    <twig:TableMobileSort label="Trier les campagnes" :selected="tableSort.column" :options="[
                        { value: 'updatedAt', label: 'Dernière mise à jour', href: path('mailing_index', { query: query, status: statusFilter, sort: 'updatedAt', direction: tableSort.nextDirectionFor('updatedAt') }) },
                        { value: 'internalTitle', label: 'Titre interne', href: path('mailing_index', { query: query, status: statusFilter, sort: 'internalTitle', direction: tableSort.nextDirectionFor('internalTitle') }) },
                        { value: 'emailSubject', label: 'Objet', href: path('mailing_index', { query: query, status: statusFilter, sort: 'emailSubject', direction: tableSort.nextDirectionFor('emailSubject') }) }
                    ]" />
                    <table class="internal-table internal-table--compact-mobile mailing-index-table">
                        <thead>
                        <tr>
                            <th><twig:TableSortHeader label="{{ 'mailing.index.table.internal_title'|trans({}, 'mailing') }}" :href="path('mailing_index', { query: query, status: statusFilter, sort: 'internalTitle', direction: tableSort.nextDirectionFor('internalTitle') })" :active="tableSort.column == 'internalTitle'" :direction="tableSort.direction" /></th>
                            <th data-table-mobile="secondary"><twig:TableSortHeader label="{{ 'mailing.index.table.email_subject'|trans({}, 'mailing') }}" :href="path('mailing_index', { query: query, status: statusFilter, sort: 'emailSubject', direction: tableSort.nextDirectionFor('emailSubject') })" :active="tableSort.column == 'emailSubject'" :direction="tableSort.direction" /></th>
                            <th data-table-mobile="primary">{{ 'mailing.index.table.status'|trans({}, 'mailing') }}</th>
                            <th data-table-mobile="secondary">{{ 'mailing.index.table.audience'|trans({}, 'mailing') }}</th>
                            <th data-table-mobile="secondary"><twig:TableSortHeader label="{{ 'mailing.index.table.updated_at'|trans({}, 'mailing') }}" :href="path('mailing_index', { query: query, status: statusFilter, sort: 'updatedAt', direction: tableSort.nextDirectionFor('updatedAt') })" :active="tableSort.column == 'updatedAt'" :direction="tableSort.direction" /></th>
                            <th>{{ 'mailing.index.table.actions'|trans({}, 'mailing') }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for campaign in campaigns %}
                            <tr class="internal-table__row--clickable" tabindex="0" data-controller="catalog-row" data-catalog-row-url-value="{{ path('mailing_content', { uuid: campaign.uuid }) }}" data-action="click->catalog-row#navigate keydown->catalog-row#navigateFromKeyboard" aria-label="{{ 'mailing.index.open'|trans({ campaign: campaign.internalTitle }, 'mailing') }}">
                                <td data-table-mobile="primary" data-label="{{ 'mailing.index.table.internal_title'|trans({}, 'mailing') }}">
                                    <span class="mailing-index__mobile-label">{{ 'mailing.index.table.internal_title'|trans({}, 'mailing') }}</span>
                                    <strong class="mailing-index__campaign-title">{{ campaign.internalTitle }}</strong>
                                </td>
                                <td data-table-mobile="secondary" data-label="{{ 'mailing.index.table.email_subject'|trans({}, 'mailing') }}">{{ campaign.emailSubject }}</td>
                                <td data-table-mobile="primary" data-label="{{ 'mailing.index.table.status'|trans({}, 'mailing') }}">
                                    <span class="mailing-index__mobile-label">{{ 'mailing.index.table.status'|trans({}, 'mailing') }}</span>
                                    <span class="internal-badge internal-badge--{{ statusBadgeVariants[campaign.status.value]|default('muted') }}">
                                        {{ ('mailing.status.' ~ campaign.status.value)|trans({}, 'mailing') }}
                                    </span>
                                </td>
                                <td data-table-mobile="secondary" data-label="{{ 'mailing.index.table.audience'|trans({}, 'mailing') }}">
                                    {% if campaign.hasAudienceCriteria %}
                                        <span class="internal-badge internal-badge--{{ campaign.audienceRecipientCount is not null ? 'success' : 'warning' }}">
                                            {% if campaign.audienceRecipientCount is not null %}
                                                {{ 'mailing.index.audience.recipients'|trans({ count: campaign.audienceRecipientCount }, 'mailing') }}
                                            {% else %}
                                                {{ 'mailing.index.audience.count_unavailable'|trans({}, 'mailing') }}
                                            {% endif %}
                                        </span>
                                    {% else %}
                                        <span class="internal-badge internal-badge--muted">
                                            {{ 'mailing.index.audience.empty'|trans({}, 'mailing') }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td data-table-mobile="secondary" data-label="{{ 'mailing.index.table.updated_at'|trans({}, 'mailing') }}">{{ campaign.updatedAt|date('d/m/Y H:i') }}</td>
                                <td data-table-mobile="actions" data-label="{{ 'mailing.index.table.actions'|trans({}, 'mailing') }}">
                                    <div class="mailing-index__actions">
                                        <a class="mailing-index__icon-button" href="{{ path('mailing_content', { uuid: campaign.uuid }) }}" aria-label="{{ 'mailing.index.open'|trans({ campaign: campaign.internalTitle }, 'mailing') }}" title="{{ (campaign.isEditable ? 'mailing.index.edit' : 'mailing.index.view')|trans({}, 'mailing') }}">
                                            {% if campaign.isEditable %}
                                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4L16.5 3.5Z"/></svg>
                                            {% else %}
                                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                                            {% endif %}
                                        </a>
                                        {% if campaign.isEditable or campaign.canExtendAudience %}
                                            <a class="mailing-index__icon-button" href="{{ campaign.isEditable ? path('mailing_audience', { uuid: campaign.uuid, returnTo: path('mailing_index') }) : path('mailing_audience_extend', { uuid: campaign.uuid, returnTo: path('mailing_index') }) }}" aria-label="{{ (campaign.isEditable ? 'mailing.index.audience.edit' : 'mailing.index.extend_audience')|trans({}, 'mailing') }}" title="{{ (campaign.isEditable ? 'mailing.index.audience.edit' : 'mailing.index.extend_audience')|trans({}, 'mailing') }}">
                                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 1v4M12 19v4M1 12h4M19 12h4"/></svg>
                                            </a>
                                        {% endif %}
                                        <div class="mailing-index__send">
                                            <a class="mailing-index__send-test" href="{{ path('mailing_test', { uuid: campaign.uuid }) }}">{{ 'mailing.index.test'|trans({}, 'mailing') }}</a>
                                            {% if campaign.isEditable %}
                                                <details class="mailing-index__send-more" data-catalog-row-ignore>
                                                    <summary aria-label="{{ 'mailing.index.other_send_options'|trans({}, 'mailing') }}" title="{{ 'mailing.index.other_send_options'|trans({}, 'mailing') }}">⌄</summary>
                                                    <div class="mailing-index__send-options">
                                                        <a href="{{ path('mailing_send', { uuid: campaign.uuid }) }}">{{ 'mailing.index.send_real'|trans({}, 'mailing') }}</a>
                                                    </div>
                                                </details>
                                            {% endif %}
                                        </div>
                                        {% if campaign.canStopDelivery %}
                                            <form method="post" action="{{ path('mailing_stop', { uuid: campaign.uuid }) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('mailing_stop_' ~ campaign.uuid) }}">
                                                <button class="internal-button internal-button--danger internal-button--compact" type="submit">
                                                    {{ 'mailing.index.stop'|trans({}, 'mailing') }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
