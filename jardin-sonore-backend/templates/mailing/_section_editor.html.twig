            {% if sectionKey != 'recommendations' and not campaignLocked %}
                {% set introPrototype %}{% include 'mailing/_intro_block_row.html.twig' with { blockForm: sectionForm.blocks.vars.prototype, locked: false } only %}{% endset %}
            {% endif %}
            <section class="mailing-intro-editor" {% if sectionKey != 'recommendations' %}data-controller="mailing-intro"{% endif %} data-mailing-intro-link-prompt-value="{{ 'mailing.form.intro_link_prompt'|trans({}, 'mailing') }}" data-mailing-intro-link-invalid-value="{{ 'mailing.form.intro_link_invalid'|trans({}, 'mailing') }}">
                <h2>{{ ('mailing.sections.' ~ sectionKey)|trans({}, 'mailing') }}</h2>
                {{ form_row(sectionForm.enabled) }}
                {% if sectionKey != 'recommendations' %}
                {{ form_errors(sectionForm.blocks) }}
                <div data-mailing-intro-target="collection" {% if not campaignLocked %}data-prototype="{{ introPrototype|e('html_attr') }}"{% endif %}>
                    {% for blockForm in sectionForm.blocks %}
                        {% include 'mailing/_intro_block_row.html.twig' with { blockForm: blockForm, locked: campaignLocked } only %}
                    {% endfor %}
                </div>
                {% if not campaignLocked %}
                    <details class="mailing-intro-editor__add">
                        <summary class="internal-button internal-button--secondary">{{ 'mailing.form.intro_add_block'|trans({}, 'mailing') }}</summary>
                        <div class="mailing-intro-editor__add-options">
                        <button type="button" class="internal-button internal-button--secondary" data-kind="paragraph" data-action="mailing-intro#add">{{ 'mailing.form.intro_add_paragraph'|trans({}, 'mailing') }}</button>
                        <button type="button" class="internal-button internal-button--secondary" data-kind="image" data-action="mailing-intro#add">{{ 'mailing.form.intro_add_image'|trans({}, 'mailing') }}</button>
                        <button type="button" class="internal-button internal-button--secondary" data-kind="split" data-action="mailing-intro#add">{{ 'mailing.form.intro_add_split'|trans({}, 'mailing') }}</button>
                        </div>
                    </details>
                {% endif %}
                {% else %}{% do sectionForm.blocks.setRendered %}{% endif %}
            </section>
