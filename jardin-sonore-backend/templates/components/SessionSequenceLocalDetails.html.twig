<div {{ attributes }} class="session-sequence-local-details session-sequence-local-details--{{ section }}">
    {% if section == 'role' and editing == 'role' %}
        <form class="session-sequence-local-details__form" data-action="live#action:prevent" data-live-action-param="save">
            <input data-model="norender|role" value="{{ role }}" autofocus>
            <button type="submit" class="internal-button internal-button--secondary internal-button--compact">{{ 'sessions.sequence.composer.save_role'|trans({}, 'sessions') }}</button>
        </form>
    {% elseif section == 'role' %}
        <button type="button" class="internal-eyebrow" {{ live_action('edit', { field: 'role' }) }}>{{ role ?: 'sessions.sequence.composer.add_role'|trans({}, 'sessions') }}</button>
    {% endif %}
    {% if section == 'details' %}
        <div class="session-sequence-local-details__instructions">
            {% for instruction in this.instructions %}
                <div class="session-sequence-local-details__instruction-row">
                    {% if editingInstructionIndex == loop.index0 %}
                        <form class="session-sequence-local-details__form" data-action="live#action:prevent" data-live-action-param="saveInstruction">
                            <input data-model="norender|instructionValue" value="{{ instructionValue }}" data-action="blur->live#action" data-live-action-param="saveInstruction" autofocus>
                        </form>
                    {% else %}
                        <button type="button" class="session-sequence-local-details__instruction" {{ live_action('startEditInstruction', { index: loop.index0 }) }}>{{ instruction }}</button>
                    {% endif %}
                    <div class="session-sequence-local-details__instruction-actions" aria-label="{{ 'sessions.sequence.composer.instruction_order'|trans({}, 'sessions') }}">
                        <button type="button" class="internal-icon-button" {{ live_action('moveInstruction', { index: loop.index0, direction: -1 }) }} {% if loop.first %}disabled{% endif %} aria-label="{{ 'sessions.sequence.composer.instruction_move_up'|trans({}, 'sessions') }}">↑</button>
                        <button type="button" class="internal-icon-button" {{ live_action('moveInstruction', { index: loop.index0, direction: 1 }) }} {% if loop.last %}disabled{% endif %} aria-label="{{ 'sessions.sequence.composer.instruction_move_down'|trans({}, 'sessions') }}">↓</button>
                    </div>
                </div>
            {% endfor %}
            {% if editingInstructionIndex == this.instructions|length %}
                <form class="session-sequence-local-details__form session-sequence-local-details__new-instruction" data-action="live#action:prevent" data-live-action-param="saveInstruction">
                    <input data-model="norender|instructionValue" value="{{ instructionValue }}" data-action="blur->live#action" data-live-action-param="saveInstruction" autofocus>
                </form>
            {% elseif editingInstructionIndex == -1 %}
                <button type="button" class="session-sequence-local-details__add-instruction" {{ live_action('addInstruction') }} aria-label="{{ 'sessions.sequence.composer.add_instruction'|trans({}, 'sessions') }}">+</button>
            {% endif %}
        </div>
    {% endif %}
    {% if section == 'notes' %}
        <details class="session-sequence-local-details__notes" {% if editing == 'notes' %}open{% endif %}>
            <summary>{{ 'sessions.sequence.composer.notes'|trans({}, 'sessions') }}</summary>
            {% if editing == 'notes' or not notes %}
                <form class="session-sequence-local-details__form" data-action="live#action:prevent" data-live-action-param="save">
                    <textarea data-model="norender|notes" rows="3" data-action="blur->live#action" data-live-action-param="save">{{ notes }}</textarea>
                </form>
            {% else %}
                <button type="button" class="session-sequence-local-details__add-note" {{ live_action('edit', { field: 'notes' }) }}>{{ notes }}</button>
            {% endif %}
        </details>
    {% endif %}
</div>
