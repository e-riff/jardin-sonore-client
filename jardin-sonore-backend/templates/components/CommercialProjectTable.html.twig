<div {{ attributes }} class="commercial-project-browser">
    <div class="commercial-project-browser__controls internal-search">
        <label class="internal-search__field">
            <span>{{ 'project.list.search'|trans({}, 'commercial') }}</span>
            <input type="search" value="{{ query }}" data-model="debounce(300)|query" placeholder="{{ 'project.list.search_placeholder'|trans({}, 'commercial') }}">
        </label>
        <label class="internal-search__field internal-search__field--compact">
            <span>{{ 'project.list.status'|trans({}, 'commercial') }}</span>
            <select data-model="on(change)|status">
                {% for value, label in {active: 'project.list.active', closed: 'project.list.closed', discussion: 'project.status.discussion', confirmed: 'project.status.confirmed', completed: 'project.status.completed', without_result: 'project.status.without_result', all: 'project.list.all'} %}
                    <option value="{{ value }}" {% if status == value %}selected{% endif %}>{{ label|trans({}, 'commercial') }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="internal-search__field internal-search__field--compact">
            <span>{{ 'project.list.sort'|trans({}, 'commercial') }}</span>
            <select data-model="on(change)|sort">
                <option value="urgency" {% if sort == 'urgency' %}selected{% endif %}>{{ 'project.list.sort_urgency'|trans({}, 'commercial') }}</option>
                <option value="recent" {% if sort == 'recent' %}selected{% endif %}>{{ 'project.list.sort_recent'|trans({}, 'commercial') }}</option>
                <option value="name" {% if sort == 'name' %}selected{% endif %}>{{ 'project.list.sort_name'|trans({}, 'commercial') }}</option>
            </select>
        </label>
    </div>

    {% set sections = this.sections %}
    {% for bucket, label in {priority: 'project.list.priority', upcoming: 'project.list.upcoming', without_task: 'project.list.without_task', confirmed: 'project.list.confirmed', closed: 'project.list.closed'} %}
        {% set rows = attribute(sections, bucket) %}
        {% if (bucket == 'closed' and status in ['all', 'closed', 'completed', 'without_result']) or (bucket != 'closed' and status not in ['closed', 'completed', 'without_result']) %}
            <details class="commercial-project-group commercial-project-group--{{ bucket }}" {% if rows is not empty and (bucket != 'closed' or status != 'all') %}open{% endif %}>
                <summary>
                    <svg class="commercial-project-group__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        {% if bucket == 'priority' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
                        {% elseif bucket == 'upcoming' %}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/>
                        {% elseif bucket == 'without_task' %}<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 9h8M8 13h8M8 17h4"/>
                        {% else %}<rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v11h14V9M10 13h4"/>{% endif %}
                    </svg>
                    <span>{{ label|trans({}, 'commercial') }}</span>
                    <span class="internal-badge internal-badge--muted">{{ rows|length }}</span>
                    <span class="commercial-project-group__chevron" aria-hidden="true">⌄</span>
                </summary>
                {% if rows is empty %}
                    <p class="internal-empty-state">{{ 'dashboard.none'|trans({}, 'commercial') }}</p>
                {% else %}
                    <div class="internal-table-wrapper">
                        <table class="internal-table internal-table--compact-mobile commercial-project-table">
                            <thead><tr>
                                <th>{{ 'project.list.dossier'|trans({}, 'commercial') }}</th>
                                <th>{{ 'project.list.state'|trans({}, 'commercial') }}</th>
                                <th>{{ 'project.list.next_task'|trans({}, 'commercial') }}</th>
                                <th>{{ 'project.list.due_on'|trans({}, 'commercial') }}</th>
                                <th>{{ 'project.list.last_activity'|trans({}, 'commercial') }}</th>
                            </tr></thead>
                            <tbody>
                            {% set periodGroups = bucket == 'upcoming' ? sections.upcoming_periods : {all: rows} %}
                            {% for period, periodRows in periodGroups %}
                                {% if bucket == 'upcoming' and periodRows is not empty %}
                                    <tr class="commercial-project-table__period-row"><th colspan="5">
                                        <span>{{ ('project.list.' ~ period)|trans({}, 'commercial') }}</span>
                                        <span class="internal-badge internal-badge--muted">{{ periodRows|length }}</span>
                                    </th></tr>
                                {% endif %}
                                {% for row in periodRows %}
                                <tr data-project-id="{{ row.id }}" class="internal-table__row--clickable commercial-project-row commercial-project-row--{{ bucket }}{{ row.nextActionId ? '' : ' commercial-project-row--no-task' }}" tabindex="0" data-controller="catalog-row" data-catalog-row-url-value="{{ path('commercial_project_show', {id: row.id}) }}" data-action="click->catalog-row#navigate keydown->catalog-row#navigateFromKeyboard">
                                    <td data-table-mobile="primary">
                                        <div class="commercial-project-row__heading">
                                            <strong title="{{ row.title }}">{{ row.title }}</strong>
                                            {% set rowStatusBadge = row.status == 'confirmed' ? 'internal-badge--secondary' : 'internal-badge--primary' %}
                                            {% if row.isNew %}<span class="internal-badge internal-badge--info">{{ 'project.list.new'|trans({}, 'commercial') }}</span>{% endif %}
                                            {% if row.isProvisional %}<span class="internal-badge internal-badge--muted">{{ 'project.list.provisional'|trans({}, 'commercial') }}</span>{% endif %}
                                        </div>
                                        <span class="internal-table-note commercial-project-row__organization">
                                            {{ row.organizationLabel }}{% if row.organizationLocation %}<span aria-hidden="true"> · </span>{{ row.organizationLocation }}{% endif %}
                                        </span>
                                        {% if row.nextActionTitle %}<span class="commercial-project-row__task-mobile">{{ row.nextActionTitle }}{% if row.extraTaskCount %} · +{{ row.extraTaskCount }}{% endif %}</span>{% endif %}
                                        {% if row.nextDueOn %}<span class="commercial-project-row__due-mobile">{{ row.nextDueOn|date('d/m/Y') }}{% if row.nextDueTime %} · {{ 'action.approx_time'|trans({'%time%': row.nextDueTime|replace({':00': ' h', ':': ' h '})}, 'commercial') }}{% endif %}</span>{% endif %}
                                    </td>
                                    <td data-table-mobile="state"><span class="internal-badge {{ rowStatusBadge }} commercial-project-row__status-desktop">{{ ('project.status.' ~ row.status)|trans({}, 'commercial') }}</span></td>
                                    <td data-table-mobile="secondary">{{ row.nextActionTitle ?: 'project.list.no_task'|trans({}, 'commercial') }}{% if row.extraTaskCount %}<span class="internal-table-note">+{{ row.extraTaskCount }}</span>{% endif %}</td>
                                    <td data-table-mobile="secondary"><span class="commercial-project-row__due">{{ row.nextDueOn ? row.nextDueOn|date('d/m/Y') : '—' }}{% if row.nextDueTime %}<br><small class="commercial-dossier__muted">{{ 'action.approx_time'|trans({'%time%': row.nextDueTime|replace({':00': ' h', ':': ' h '})}, 'commercial') }}</small>{% endif %}</span></td>
                                    <td data-table-mobile="activity"><span class="commercial-project-row__activity-label">{{ 'project.list.last_activity'|trans({}, 'commercial') }} :</span> <time datetime="{{ row.lastEventAt ? row.lastEventAt|date('c') : '' }}">{{ row.lastEventAt ? row.lastEventAt|date('d/m/Y') : '—' }}</time></td>
                                </tr>
                                {% endfor %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </details>
        {% endif %}
    {% endfor %}
</div>
