parameters:
  app.mcp.bearer_token: '%env(MCP_BEARER_TOKEN)%'
  app.mcp.write_enabled: '%env(bool:MCP_WRITE_ENABLED)%'
  app.mcp.draft_write_enabled: '%env(bool:MCP_DRAFT_WRITE_ENABLED)%'
  app.mcp.draft_edit_enabled: '%env(bool:MCP_DRAFT_EDIT_ENABLED)%'
  app.mcp.draft_compose_enabled: '%env(bool:MCP_DRAFT_COMPOSE_ENABLED)%'
  app.mcp.mailing_write_enabled: '%env(bool:MCP_MAILING_WRITE_ENABLED)%'
  app.mcp.imap_host: '%env(MCP_IMAP_HOST)%'
  app.mcp.imap_port: '%env(int:MCP_IMAP_PORT)%'
  app.mcp.imap_username: '%env(MCP_IMAP_USERNAME)%'
  app.mcp.imap_password: '%env(MCP_IMAP_PASSWORD)%'
  app.mcp.imap_sent_folder: '%env(MCP_IMAP_SENT_FOLDER)%'
  app.mcp.imap_drafts_folder: '%env(MCP_IMAP_DRAFTS_FOLDER)%'
  app.commercial.drive_root_url: 'https://drive.google.com/drive/folders/1k1LeqBn1M2kApAxlEyCpEdbZpvD51Sfl'
  app.commercial.drive_quotes_url: 'https://drive.google.com/drive/folders/1QaLCUp9EzKwbwpRv-jZ_GxuwweMZ5Cqk'
  app.commercial.drive_signed_quotes_url: 'https://drive.google.com/drive/folders/1WO_Fh9yZBh0jR9ar9cn4eJghx0UZOiSx'
  app.commercial.drive_invoices_url: 'https://drive.google.com/drive/folders/1V2fYMge2IfWACJs8pbc0KKHMQ31amSFO'
  app.commercial.calendar_client_id: '%env(GOOGLE_CALENDAR_CLIENT_ID)%'
  app.commercial.calendar_client_secret: '%env(GOOGLE_CALENDAR_CLIENT_SECRET)%'
  app.commercial.calendar_id: '%env(GOOGLE_CALENDAR_ID)%'
  app.commercial.calendar_redirect_uri: '%env(GOOGLE_CALENDAR_REDIRECT_URI)%'
  app.commercial.calendar_encryption_key: '%env(GOOGLE_CALENDAR_ENCRYPTION_KEY)%'
  app.mailing.home_latitude: '%env(default::MAILING_HOME_LATITUDE)%'
  app.mailing.home_longitude: '%env(default::MAILING_HOME_LONGITUDE)%'
  app.mailing.window_limit: '%env(int:MAILING_WINDOW_LIMIT)%'
  app.mailing.window_minutes: '%env(int:MAILING_WINDOW_MINUTES)%'
  app.mailing.dispatch_batch_size: '%env(int:MAILING_DISPATCH_BATCH_SIZE)%'
  app.mailing.from_email: '%env(DEFAULT_CONTACT)%'
  app.mailing.from_name: '%env(MAILING_FROM_NAME)%'
  app.portal.password_link_ttl: '%env(int:PORTAL_PASSWORD_LINK_TTL)%'
  app.portal.session_ttl: '%env(int:PORTAL_SESSION_TTL)%'
  app.portal.impersonation_launch_ttl: '%env(int:PORTAL_IMPERSONATION_LAUNCH_TTL)%'
  app.portal.impersonation_session_ttl: '%env(int:PORTAL_IMPERSONATION_SESSION_TTL)%'
  app.portal.public_base_url: '%env(PORTAL_PUBLIC_URL)%'
